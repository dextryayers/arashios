# ArashiOS release and build configuration.
# Semua nilai di file ini adalah sumber kebenaran untuk build.

ARASHIOS_VERSION="V1.10.21"
ARASHIOS_CODENAME="Shizukesa"
ARASHIOS_DESIGN="Kage"

DEBIAN_CODENAME="bookworm"
# Kosongkan untuk memakai mirror biasa. Isi dengan timestamp snapshot.debian.org
# pada Fase 1 untuk build yang reproducible, contoh: 20261020T000000Z
DEBIAN_SNAPSHOT="${DEBIAN_SNAPSHOT:-}"

SUPPORTED_ARCHES="amd64 arm64 i386"
SUPPORTED_EDITIONS="cinnamon xfce lxqt"

DEFAULT_EDITION_AMD64="cinnamon"
DEFAULT_EDITION_ARM64="xfce"
DEFAULT_EDITION_I386="lxqt"

ISO_PUBLISHER="ArashiOS Project"
ISO_APPLICATION="ArashiOS"
ISO_VOLUME_PREFIX="ARASHIOS"

# Ukuran maksimum ISO dalam MiB, dipakai oleh test/verify-artifact.sh
MAX_ISO_MIB_CINNAMON=4300
MAX_ISO_MIB_XFCE=4000
MAX_ISO_MIB_LXQT=3600
