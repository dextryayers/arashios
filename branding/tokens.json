{
  "meta": {
    "name": "Kage",
    "version": "0.1.0",
    "license": "CC-BY-SA-4.0",
    "description": "Japanese minimal design system for ArashiOS with red team accents."
  },
  "color": {
    "sumi": {
      "900": "#070709",
      "800": "#0A0A0C",
      "700": "#121216",
      "600": "#1B1B21",
      "500": "#25252D",
      "400": "#34343E"
    },
    "washi": {
      "50": "#F7F4EE",
      "100": "#EDE8DE",
      "200": "#D8D2C6"
    },
    "ash": {
      "300": "#B8B2A7",
      "400": "#8B867D",
      "500": "#6B675F"
    },
    "ember": {
      "400": "#E8917A",
      "500": "#DD785B",
      "600": "#C46248"
    },
    "vermilion": {
      "400": "#D05545",
      "500": "#BF4432",
      "600": "#9E3527"
    },
    "jade": {
      "400": "#5FA88C",
      "500": "#3E8A72"
    },
    "gold": {
      "400": "#D6B36A",
      "500": "#B8934A"
    }
  },
  "semantic": {
    "bg": "sumi.800",
    "bgAlt": "sumi.900",
    "surface": "sumi.700",
    "surfaceRaised": "sumi.600",
    "surfaceSunken": "sumi.900",
    "text": "washi.100",
    "textMuted": "ash.400",
    "textSubtle": "ash.500",
    "textInverse": "sumi.900",
    "accent": "ember.500",
    "accentHover": "ember.400",
    "accentPressed": "ember.600",
    "accentStrong": "vermilion.500",
    "accentStrongHover": "vermilion.400",
    "onAccent": "sumi.900",
    "success": "jade.400",
    "warning": "gold.400",
    "danger": "vermilion.400",
    "dangerStrong": "vermilion.500",
    "border": "sumi.500",
    "borderStrong": "sumi.400",
    "focus": "ember.400"
  },
  "typography": {
    "fontFamily": {
      "sans": "Inter, \"Noto Sans\", \"DejaVu Sans\", sans-serif",
      "mono": "\"JetBrains Mono\", \"DejaVu Sans Mono\", monospace",
      "display": "Inter, \"Noto Sans JP\", \"Noto Sans\", sans-serif"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "2rem",
      "4xl": "3rem"
    },
    "lineHeight": {
      "tight": "1.2",
      "normal": "1.5",
      "relaxed": "1.7"
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "letterSpacing": {
      "tight": "-0.01em",
      "normal": "0",
      "wide": "0.08em"
    }
  },
  "space": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "7": "2rem",
    "8": "2.5rem",
    "9": "3rem",
    "10": "4rem",
    "11": "6rem",
    "12": "8rem"
  },
  "radius": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "xl": "16px",
    "full": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(0, 0, 0, 0.40)",
    "md": "0 4px 12px rgba(0, 0, 0, 0.35)",
    "lg": "0 12px 32px rgba(0, 0, 0, 0.45)",
    "glow": "0 0 0 1px rgba(221, 120, 91, 0.35), 0 0 24px rgba(221, 120, 91, 0.18)"
  },
  "motion": {
    "durationFast": "120ms",
    "durationBase": "180ms",
    "durationSlow": "280ms",
    "easingStandard": "cubic-bezier(0.2, 0, 0, 1)",
    "easingEmphasized": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "assets": {
    "mark": "branding/logo/arashios-mark.svg",
    "wallpaper": "branding/wallpaper/kage-sumi.svg",
    "grubTheme": "branding/grub/theme.txt",
    "plymouthTheme": "branding/plymouth/arashios.plymouth"
  },
  "contrastPairs": [
    {
      "fg": "washi.100",
      "bg": "sumi.800",
      "min": 7.0,
      "usage": "Body text on background"
    },
    {
      "fg": "washi.100",
      "bg": "sumi.700",
      "min": 7.0,
      "usage": "Body text on surface"
    },
    {
      "fg": "ash.400",
      "bg": "sumi.800",
      "min": 4.5,
      "usage": "Muted text on background"
    },
    {
      "fg": "ash.400",
      "bg": "sumi.700",
      "min": 4.5,
      "usage": "Muted text on surface"
    },
    {
      "fg": "ember.500",
      "bg": "sumi.800",
      "min": 4.5,
      "usage": "Accent text and links"
    },
    {
      "fg": "vermilion.500",
      "bg": "sumi.800",
      "min": 3.0,
      "usage": "Large accent text and UI fills"
    },
    {
      "fg": "sumi.900",
      "bg": "ember.500",
      "min": 4.5,
      "usage": "Primary button label"
    },
    {
      "fg": "jade.400",
      "bg": "sumi.800",
      "min": 4.5,
      "usage": "Success text"
    },
    {
      "fg": "gold.400",
      "bg": "sumi.800",
      "min": 4.5,
      "usage": "Warning text"
    },
    {
      "fg": "vermilion.400",
      "bg": "sumi.800",
      "min": 4.5,
      "usage": "Danger text"
    }
  ]
}
