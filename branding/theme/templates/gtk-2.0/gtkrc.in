# ArashiOS Kage GTK2 fallback theme.
# Generated by scripts/generate-theme.py from branding/tokens.json.
# Source template: branding/theme/templates/gtk-2.0/gtkrc.in

gtk-color-scheme = "fg_color:$text\nbg_color:$bg\nbase_color:$surface_sunken\ntext_color:$text\nselected_bg_color:$accent_strong\nselected_fg_color:$washi_50\ntooltip_bg_color:$surface\ntooltip_fg_color:$text\nlink_color:$accent\nvisited_link_color:$accent_pressed"
gtk-font-name = "Inter 11"
gtk-icon-theme-name = "Papirus-Dark"
gtk-enable-animations = 1
gtk-menu-images = 1
gtk-button-images = 0
gtk-toolbar-style = 0
gtk-toolbar-icon-size = 1

style "kage-default" {
  fg[NORMAL] = "$text"
  fg[PRELIGHT] = "$text"
  fg[ACTIVE] = "$text"
  fg[SELECTED] = "$washi_50"
  fg[INSENSITIVE] = "$text_muted"
  bg[NORMAL] = "$bg"
  bg[PRELIGHT] = "$surface"
  bg[ACTIVE] = "$bg_alt"
  bg[SELECTED] = "$accent_strong"
  bg[INSENSITIVE] = "$bg"
  base[NORMAL] = "$surface_sunken"
  base[PRELIGHT] = "$surface"
  base[ACTIVE] = "$bg_alt"
  base[SELECTED] = "$accent_strong"
  base[INSENSITIVE] = "$bg"
  text[NORMAL] = "$text"
  text[PRELIGHT] = "$text"
  text[ACTIVE] = "$text"
  text[SELECTED] = "$washi_50"
  text[INSENSITIVE] = "$text_muted"

  engine "murrine" {
    contrast = 1.0
    border_shades = { 1.0, 1.0 }
    reliefstyle = 5
    gradient_shades = { 1.0, 1.0, 1.0, 1.0 }
    glow_shades = { 1.0, 1.0, 1.0, 1.0 }
    focus_color = "$focus"
    focusstyle = 3
    menubarstyle = 0
    menuitemstyle = 0
    scrollbarstyle = 0
    sliderstyle = 0
    stepperstyle = 0
    toolbarstyle = 0
    roundness = 2
  }
}

style "kage-button" {
  xthickness = 8
  ythickness = 4
  bg[NORMAL] = "$surface_raised"
  bg[PRELIGHT] = "$surface"
  bg[ACTIVE] = "$bg_alt"
  bg[SELECTED] = "$accent_strong"
  fg[NORMAL] = "$text"
  fg[PRELIGHT] = "$text"
  fg[ACTIVE] = "$text"
  fg[SELECTED] = "$washi_50"
}

style "kage-entry" {
  base[NORMAL] = "$bg_alt"
  base[PRELIGHT] = "$bg_alt"
  base[ACTIVE] = "$bg_alt"
  base[SELECTED] = "$accent_strong"
  text[NORMAL] = "$text"
  text[SELECTED] = "$washi_50"
  bg[NORMAL] = "$bg_alt"
  fg[NORMAL] = "$text"
}

style "kage-menu" {
  bg[NORMAL] = "$surface_raised"
  bg[PRELIGHT] = "$accent_strong"
  bg[ACTIVE] = "$accent_pressed"
  fg[NORMAL] = "$text"
  fg[PRELIGHT] = "$washi_50"
  fg[ACTIVE] = "$washi_50"
}

style "kage-tooltip" {
  bg[NORMAL] = "$surface"
  fg[NORMAL] = "$text"
  bg[PRELIGHT] = "$surface"
  fg[PRELIGHT] = "$text"
}

class "*" style "kage-default"
widget_class "*<GtkButton>" style "kage-button"
widget_class "*<GtkEntry>" style "kage-entry"
widget_class "*<GtkMenuItem>" style "kage-menu"
widget_class "*<GtkMenuBar>" style "kage-menu"
widget_class "*<GtkTooltip>" style "kage-tooltip"
