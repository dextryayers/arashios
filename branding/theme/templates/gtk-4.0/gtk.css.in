/* ArashiOS Kage GTK4 theme and libadwaita color map.
 * Generated by scripts/generate-theme.py from branding/tokens.json.
 * Source template: branding/theme/templates/gtk-4.0/gtk.css.in
 */

@define-color theme_bg_color $bg;
@define-color theme_fg_color $text;
@define-color theme_base_color $surface_sunken;
@define-color theme_text_color $text;
@define-color theme_selected_bg_color $accent_strong;
@define-color theme_selected_fg_color $washi_50;
@define-color theme_unfocused_bg_color $bg;
@define-color theme_unfocused_fg_color $text_muted;
@define-color insensitive_fg_color $ash_500;
@define-color borders $border;
@define-color unfocused_borders $border;
@define-color warning_color $warning;
@define-color error_color $danger;
@define-color success_color $success;
@define-color content_view_bg $surface;
@define-color text_view_bg $surface_sunken;

/* Libadwaita 1.x public color names. */
@define-color accent_color $accent;
@define-color accent_bg_color $accent_strong;
@define-color accent_fg_color $washi_50;
@define-color window_bg_color $bg;
@define-color window_fg_color $text;
@define-color view_bg_color $surface_sunken;
@define-color view_fg_color $text;
@define-color headerbar_bg_color $surface;
@define-color headerbar_fg_color $text;
@define-color headerbar_border_color $border;
@define-color headerbar_backdrop_color $bg;
@define-color headerbar_shade_color $border;
@define-color card_bg_color $surface;
@define-color card_fg_color $text;
@define-color card_shade_color $border;
@define-color dialog_bg_color $surface_raised;
@define-color dialog_fg_color $text;
@define-color popover_bg_color $surface_raised;
@define-color popover_fg_color $text;
@define-color popover_shade_color $border;
@define-color sidebar_bg_color $bg_alt;
@define-color sidebar_fg_color $text;
@define-color sidebar_backdrop_color $bg_alt;
@define-color sidebar_shade_color $border;
@define-color secondary_sidebar_bg_color $bg;
@define-color secondary_sidebar_fg_color $text;
@define-color secondary_sidebar_backdrop_color $bg;
@define-color secondary_sidebar_shade_color $border;
@define-color shade_color $border;
@define-color scrollbar_outline_color $bg_alt;
@define-color destructive_color $danger;
@define-color destructive_bg_color $danger_strong;
@define-color destructive_fg_color $washi_50;
@define-color success_bg_color $success;
@define-color success_fg_color $bg_alt;
@define-color warning_bg_color $warning;
@define-color warning_fg_color $bg_alt;
@define-color error_bg_color $danger_strong;
@define-color error_fg_color $washi_50;
@define-color thumbnail_bg_color $surface;
@define-color thumbnail_fg_color $text;

window,
.background {
  background-color: $bg;
  color: $text;
  font-family: $gtk_font_family;
  font-size: 11pt;
}

window:backdrop,
.background:backdrop {
  color: $text_muted;
}

headerbar,
.titlebar {
  min-height: 34px;
  padding: 4px 8px;
  background-color: $surface;
  background-image: none;
  color: $text;
  border-bottom: 1px solid $border;
  box-shadow: none;
}

headerbar:backdrop,
.titlebar:backdrop {
  background-color: $bg;
  color: $text_muted;
}

headerbar .title,
.titlebar .title {
  color: $text;
  font-weight: 600;
}

headerbar .subtitle,
.titlebar .subtitle {
  color: $text_muted;
  font-size: 9pt;
}

headerbar button,
.titlebar button {
  min-height: 26px;
  padding: 3px 9px;
  background-color: transparent;
  border-color: transparent;
}

headerbar button:hover,
.titlebar button:hover {
  background-color: $surface_raised;
  border-color: $border;
}

button,
.button {
  min-height: 30px;
  min-width: 16px;
  padding: 5px 12px;
  border: 1px solid $border;
  border-radius: $radius_sm;
  background-image: none;
  background-color: $surface_raised;
  color: $text;
  box-shadow: none;
  text-shadow: none;
  transition: background-color 120ms cubic-bezier(0.2, 0, 0, 1),
              border-color 120ms cubic-bezier(0.2, 0, 0, 1);
}

button:hover,
.button:hover {
  background-color: $surface;
  border-color: $accent;
}

button:active,
button:checked,
.button:active,
.button:checked {
  background-color: $bg_alt;
  border-color: $border_strong;
}

button:disabled,
.button:disabled {
  background-color: $bg;
  border-color: $border;
  color: $ash_500;
}

button:focus-visible,
button:focus {
  border-color: $focus;
  box-shadow: 0 0 0 2px $focus;
}

button.flat {
  background-color: transparent;
  border-color: transparent;
}

button.flat:hover {
  background-color: $surface_raised;
  border-color: $border;
}

button.suggested-action,
button.default {
  background-color: $accent;
  border-color: $accent;
  color: $on_accent;
}

button.suggested-action:hover,
button.default:hover {
  background-color: $accent_hover;
  border-color: $accent_hover;
}

button.destructive-action {
  background-color: $danger_strong;
  border-color: $danger_strong;
  color: $washi_50;
}

button.circular {
  min-width: 30px;
  min-height: 30px;
  padding: 0;
  border-radius: 15px;
}

entry,
spinbutton,
searchentry,
dropdown button {
  min-height: 30px;
  padding: 5px 9px;
  border: 1px solid $border;
  border-radius: $radius_sm;
  background-color: $bg_alt;
  background-image: none;
  color: $text;
  caret-color: $focus;
  transition: border-color 120ms cubic-bezier(0.2, 0, 0, 1);
}

entry:hover,
spinbutton:hover,
searchentry:hover,
dropdown button:hover {
  border-color: $border_strong;
}

entry:focus,
entry:focus-within,
spinbutton:focus,
searchentry:focus,
dropdown button:focus {
  border-color: $focus;
  box-shadow: inset 0 0 0 1px $focus;
}

entry:disabled,
spinbutton:disabled,
searchentry:disabled {
  background-color: $bg;
  border-color: $border;
  color: $ash_500;
}

entry selection,
textview selection,
label selection,
selection {
  background-color: $accent_strong;
  color: $washi_50;
}

textview,
textview text {
  background-color: $surface_sunken;
  color: $text;
}

textview border {
  background-color: $border;
}

listview,
list,
columnview,
gridview,
.view {
  background-color: $surface;
  color: $text;
  border: 1px solid $border;
  border-radius: $radius_sm;
}

listview > row,
list row,
columnview > row,
gridview > child {
  min-height: 30px;
  padding: 4px 8px;
  background-color: transparent;
  border-radius: $radius_sm;
}

listview > row:hover,
list row:hover,
columnview > row:hover {
  background-color: $surface_raised;
}

listview > row:selected,
list row:selected,
columnview > row:selected,
gridview > child:selected {
  background-color: $accent_strong;
  color: $washi_50;
}

listview > row:disabled,
list row:disabled {
  color: $ash_500;
}

listview > header,
columnview > header {
  min-height: 30px;
  background-color: $surface_raised;
  color: $text_muted;
  border-bottom: 1px solid $border;
  font-weight: 600;
}

popover,
popover.background,
popover > contents {
  background-color: $surface_raised;
  color: $text;
  border: 1px solid $border;
  border-radius: $radius_md;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  padding: 4px;
}

popover modelbutton,
menuitem {
  min-height: 26px;
  padding: 5px 10px;
  border-radius: $radius_sm;
  color: $text;
}

popover modelbutton:hover,
menuitem:hover {
  background-color: $accent_strong;
  color: $washi_50;
}

menu,
.menu {
  background-color: $surface_raised;
  color: $text;
  border: 1px solid $border;
  border-radius: $radius_md;
  padding: 4px;
}

menubar {
  background-color: $surface;
  color: $text;
  border-bottom: 1px solid $border;
}

menubar > item {
  padding: 6px 10px;
  color: $text;
  border-radius: 0;
}

menubar > item:hover {
  background-color: $surface_raised;
}

toolbar,
.toolbar {
  background-color: $surface;
  color: $text;
  border: 0;
  padding: 4px;
}

tooltip,
.tooltip {
  background-color: $surface_raised;
  color: $text;
  border: 1px solid $border_strong;
  border-radius: $radius_sm;
  padding: 4px 8px;
  box-shadow: none;
}

tooltip label {
  color: $text;
}

notebook,
notebook.frame {
  background-color: $bg;
  border: 1px solid $border;
  border-radius: $radius_sm;
}

notebook > header {
  background-color: $surface;
  border-bottom: 1px solid $border;
}

notebook > header > tabs > tab {
  min-height: 26px;
  padding: 5px 14px;
  border: 0;
  border-right: 1px solid $border;
  border-radius: 0;
  background-color: $surface;
  color: $text_muted;
}

notebook > header > tabs > tab:hover {
  background-color: $surface_raised;
  color: $text;
}

notebook > header > tabs > tab:checked {
  background-color: $surface_raised;
  color: $text;
  box-shadow: inset 0 -2px 0 $accent_strong;
}

notebook > stack {
  background-color: $bg;
}

scrollbar {
  background-color: transparent;
  border: 0;
}

scrollbar trough {
  background-color: $surface;
  border: 0;
  border-radius: 0;
}

scrollbar slider {
  min-width: 8px;
  min-height: 32px;
  margin: 2px;
  border: 1px solid $border;
  border-radius: $radius_sm;
  background-color: $border_strong;
}

scrollbar slider:hover {
  background-color: $accent;
  border-color: $accent;
}

scrollbar slider:active {
  background-color: $accent_pressed;
  border-color: $accent_pressed;
}

separator,
.separator {
  background-color: $border;
  min-width: 1px;
  min-height: 1px;
}

paned > separator {
  background-color: $border;
  min-width: 1px;
  min-height: 1px;
}

frame,
.frame {
  border: 1px solid $border;
  border-radius: $radius_sm;
  background-color: transparent;
}

statusbar,
.statusbar {
  background-color: $surface;
  color: $text_muted;
  border-top: 1px solid $border;
  padding: 4px 8px;
}

progressbar,
progressbar trough {
  min-height: 6px;
  border: 1px solid $border;
  border-radius: 0;
  background-color: $surface;
}

progressbar progress {
  min-height: 6px;
  border: 0;
  border-radius: 0;
  background-color: $accent_strong;
}

levelbar block,
levelbar trough {
  min-height: 6px;
  border-radius: 0;
}

levelbar block.filled {
  background-color: $success;
  border-color: $success;
}

levelbar block.low {
  background-color: $danger;
}

levelbar block.high {
  background-color: $success;
}

scale trough {
  min-height: 4px;
  border: 0;
  border-radius: 0;
  background-color: $surface_raised;
}

scale highlight {
  background-color: $accent_strong;
  border-radius: 0;
}

scale slider {
  min-width: 14px;
  min-height: 14px;
  margin: -5px;
  border: 1px solid $accent_pressed;
  border-radius: 7px;
  background-color: $accent;
}

scale slider:hover {
  background-color: $accent_hover;
  border-color: $accent_hover;
}

switch {
  min-width: 42px;
  min-height: 22px;
  padding: 2px;
  border: 1px solid $border;
  border-radius: 12px;
  background-color: $surface;
}

switch:checked {
  background-color: $accent_strong;
  border-color: $accent_strong;
}

switch slider {
  min-width: 18px;
  min-height: 18px;
  border: 0;
  border-radius: 9px;
  background-color: $text;
}

switch:checked slider {
  background-color: $washi_50;
}

checkbutton,
radiobutton {
  background-color: transparent;
  color: $text;
}

checkbutton check,
radiobutton radio {
  min-width: 16px;
  min-height: 16px;
  border: 1px solid $border_strong;
  background-color: $surface;
  color: $washi_50;
}

checkbutton check {
  border-radius: $radius_sm;
}

radiobutton radio {
  border-radius: 8px;
}

checkbutton check:checked,
radiobutton radio:checked {
  background-color: $accent_strong;
  border-color: $accent_strong;
}

calendar {
  background-color: $surface;
  color: $text;
  border: 1px solid $border;
  padding: 4px;
}

calendar:selected {
  background-color: $accent_strong;
  color: $washi_50;
}

calendar.header {
  background-color: $surface_raised;
  color: $text_muted;
}

calendar.highlight {
  color: $accent;
  font-weight: 600;
}

expander arrow {
  color: $text_muted;
}

colorswatch {
  border: 1px solid $border_strong;
  border-radius: $radius_sm;
}

colorswatch:selected {
  border-color: $focus;
  box-shadow: 0 0 0 1px $focus;
}

navigation-sidebar,
.navigation-sidebar {
  background-color: $bg_alt;
  color: $text;
  border-right: 1px solid $border;
}

navigation-sidebar > row {
  min-height: 30px;
  padding: 4px 8px;
  border-radius: $radius_sm;
}

navigation-sidebar > row:hover {
  background-color: $surface;
}

navigation-sidebar > row:selected {
  background-color: $surface_raised;
  color: $text;
  box-shadow: inset 2px 0 0 $accent_strong;
}

.sidebar,
.sidebar-pane {
  background-color: $bg_alt;
  color: $text;
  border-right: 1px solid $border;
}

.card,
.card.background {
  background-color: $surface;
  color: $text;
  border: 1px solid $border;
  border-radius: $radius_md;
}

dialog,
window.dialog {
  background-color: $surface_raised;
  color: $text;
}

dialog .dialog-action-area,
dialog .dialog-vbox {
  background-color: $surface_raised;
}

banner,
.banner {
  background-color: $surface_raised;
  color: $text;
  border-bottom: 1px solid $border;
}

banner > revealer > widget {
  padding: 8px 12px;
}

toast,
.toast {
  background-color: $surface_raised;
  color: $text;
  border: 1px solid $border;
  border-left: 3px solid $accent;
  border-radius: $radius_sm;
  padding: 8px 12px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
}

infobar,
infobar > revealer > box {
  border: 1px solid $border;
  border-radius: 0;
}

infobar.info > revealer > box {
  background-color: $surface_raised;
  color: $text;
  border-left: 3px solid $accent;
}

infobar.warning > revealer > box {
  background-color: $surface_raised;
  color: $text;
  border-left: 3px solid $warning;
}

infobar.error > revealer > box {
  background-color: $surface_raised;
  color: $text;
  border-left: 3px solid $danger;
}

infobar.success > revealer > box {
  background-color: $surface_raised;
  color: $text;
  border-left: 3px solid $success;
}

.osd,
.osd.background {
  background-color: alpha($bg_alt, 0.94);
  color: $text;
  border: 1px solid $border;
  border-radius: $radius_sm;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
}

.dnd,
.dnd-target,
.drag-icon {
  background-color: $surface_raised;
  border: 1px solid $focus;
  border-radius: $radius_sm;
}

rubberband,
.rubberband {
  background-color: alpha($accent_strong, 0.20);
  border: 1px solid $accent;
}

tabbar,
tabbar > box {
  background-color: $surface;
  border-bottom: 1px solid $border;
}

tabbar tab {
  min-height: 28px;
  padding: 5px 12px;
  border-radius: 0;
  color: $text_muted;
}

tabbar tab:hover {
  background-color: $surface_raised;
  color: $text;
}

tabbar tab:selected {
  background-color: $bg;
  color: $text;
  box-shadow: inset 0 -2px 0 $accent_strong;
}

/* Application-specific hooks that follow the same token contract. */
.gedit-side-panel-paned,
.gedit-bottom-panel-paned {
  background-color: $bg_alt;
  border-color: $border;
}

.gedit-document-panel {
  background-color: $bg_alt;
}

.gedit-document-panel row:selected {
  background-color: $surface_raised;
  box-shadow: inset 2px 0 0 $accent_strong;
}

.nemo-window .sidebar,
.nemo-window .nemo-places-sidebar {
  background-color: $bg_alt;
  color: $text;
  border-right: 1px solid $border;
}

.nemo-window .nemo-places-sidebar .view:selected {
  background-color: $surface_raised;
  color: $text;
  box-shadow: inset 2px 0 0 $accent_strong;
}

.xfce4-panel,
.xfce4-panel.background {
  background-color: $bg_alt;
  color: $text;
  border-top: 1px solid $border;
}

.xfce4-panel button {
  min-height: 24px;
  padding: 2px 6px;
  border-radius: 0;
}

.xfce4-panel .tasklist button:checked {
  box-shadow: inset 0 -2px 0 $accent_strong;
}
