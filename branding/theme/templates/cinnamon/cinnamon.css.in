/* ArashiOS Kage Cinnamon theme.
 * Generated by scripts/generate-theme.py from branding/tokens.json.
 * Source template: branding/theme/templates/cinnamon/cinnamon.css.in
 *
 * Layout contract: top panel, 30 px, icon-only grouped window list, four
 * vertical workspace indicators, and notifications without rounded corners.
 */

stage {
  font-family: $cinnamon_font_family;
  font-size: 11pt;
  color: $text;
}

.label-shadow {
  color: transparent;
}

.panel {
  height: 30px;
  background-color: alpha($bg_alt, 0.96);
  color: $text;
  border: 0;
  border-bottom: 1px solid $border_strong;
  box-shadow: none;
}

.panel-top {
  border-bottom: 1px solid $border_strong;
}

.panel-bottom {
  border-top: 1px solid $border_strong;
}

.panel .applet-box,
.panel .applet-box:visited {
  padding: 0 6px;
  spacing: 4px;
  color: $text;
  background-color: transparent;
  border: 0;
  border-radius: 0;
  text-shadow: none;
}

.panel .applet-box:hover {
  background-color: alpha($surface_raised, 0.86);
  box-shadow: inset 0 -2px 0 $accent_strong;
}

.panel .applet-box:checked,
.panel .applet-box:active {
  background-color: $surface_raised;
  box-shadow: inset 0 -2px 0 $accent_strong;
}

.panel .applet-box:focus {
  border: 1px solid $focus;
  box-shadow: inset 0 0 0 1px $focus;
}

.panel .applet-label {
  color: $text;
  font-family: $mono_font_family;
  font-size: 10pt;
  font-weight: 400;
  text-shadow: none;
}

.panel .applet-icon {
  icon-size: 16px;
  color: $text;
}

.panel .applet-box:hover .applet-label,
.panel .applet-box:checked .applet-label {
  color: $text;
}

.panel .applet-separator {
  width: 1px;
  margin: 8px 4px;
  background-color: $border;
}

.panel .applet-separator-line {
  width: 1px;
  background-color: $border;
}

.panel .menu-label {
  font-family: $mono_font_family;
  font-size: 10pt;
  font-weight: 600;
  letter-spacing: 0.04em;
}

.panel .menu-favorites-box,
.panel .menu-applications-box,
.panel .menu-categories-box,
.panel .menu-search-box {
  background-color: transparent;
}

#panel .panel-button {
  -natural-hpadding: 6px;
  -minimum-hpadding: 4px;
  color: $text;
}

.panel-status-button {
  border: 0;
  border-radius: 0;
  padding: 0 4px;
  color: $text;
}

.panel-status-button:hover {
  background-color: $surface_raised;
}

.panel-status-button:active,
.panel-status-button:checked {
  background-color: $surface_raised;
  box-shadow: inset 0 -2px 0 $accent_strong;
}

.window-list-item-box,
.window-list-item-box:active,
.window-list-item-box:checked,
.window-list-item-box:focus {
  color: $text;
  background-color: transparent;
  border: 0;
  border-radius: 0;
  padding: 0 4px;
  transition-duration: 120ms;
}

.window-list-item-box:hover {
  background-color: alpha($surface_raised, 0.84);
}

.window-list-item-box:checked,
.window-list-item-box:active {
  box-shadow: inset 0 -2px 0 $accent_strong;
}

.window-list-item-box .progress {
  background-color: $accent_strong;
}

.window-list-item-demands-attention {
  background-gradient-direction: vertical;
  background-gradient-start: $warning;
  background-gradient-end: $surface;
}

.window-list-preview {
  background-color: $surface_raised;
  border: 1px solid $border;
  border-radius: 0;
  padding: 6px;
  color: $text;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
}

.grouped-window-list-item-box {
  padding: 0 4px;
  spacing: 3px;
  border: 0;
  border-radius: 0;
  background-color: transparent;
  color: $text_muted;
  transition-duration: 120ms;
}

.grouped-window-list-item-box:hover {
  background-color: alpha($surface_raised, 0.84);
  color: $text;
}

.grouped-window-list-item-box:active,
.grouped-window-list-item-box:checked,
.grouped-window-list-item-box:focus {
  color: $text;
  background-color: transparent;
  box-shadow: inset 0 -2px 0 $accent_strong;
}

.grouped-window-list-item-box:active:hover,
.grouped-window-list-item-box:checked:hover {
  background-color: alpha($surface_raised, 0.92);
}

.grouped-window-list-item-demands-attention {
  background-color: $warning;
  color: $bg_alt;
}

.grouped-window-list-badge {
  background-color: $accent_strong;
  color: $washi_50;
  border: 0;
  border-radius: 7px;
  font-size: 8pt;
  font-weight: 600;
  padding: 0 3px;
}

.grouped-window-list-thumbnail-menu {
  background-color: $surface_raised;
  border: 1px solid $border;
  border-radius: 0;
  padding: 6px;
  color: $text;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
}

.grouped-window-list-thumbnail-label {
  color: $text_muted;
  font-size: 9pt;
  padding-top: 4px;
}

.grouped-window-list-number-label {
  color: $washi_50;
  font-family: $mono_font_family;
  font-size: 8pt;
}

.workspace-button {
  width: 22px;
  height: 18px;
  margin: 6px 1px;
  color: $text_muted;
  background-color: transparent;
  border: 0;
  border-left: 2px solid $border_strong;
  border-radius: 0;
  transition-duration: 120ms;
}

.workspace-button:hover {
  color: $text;
  border-left-color: $accent;
  background-color: alpha($surface_raised, 0.6);
}

.workspace-button:selected,
.workspace-button:active,
.workspace-button:checked {
  color: $text;
  border-left-color: $accent_strong;
  background-color: $surface_raised;
}

.workspace-button:focus {
  border: 1px solid $focus;
  border-left: 2px solid $focus;
}

.workspace-osd {
  color: $washi_50;
  background-color: alpha($bg_alt, 0.96);
  border: 1px solid $border_strong;
  border-radius: 0;
  padding: 12px 18px;
  font-family: $mono_font_family;
  font-size: 14pt;
}

.expo-background {
  background-color: alpha($bg_alt, 0.93);
}

.expo-workspace-thumbnail-frame {
  background-color: $surface;
  border: 1px solid $border_strong;
  border-radius: 0;
}

.expo-workspace-thumbnail-frame#active {
  border: 2px solid $accent_strong;
}

.expo-workspaces-name-entry {
  color: $text_muted;
  background-color: $surface;
  border: 1px solid $border;
  border-radius: 0;
  padding: 4px 8px;
  selected-color: $washi_50;
  selection-background-color: $accent_strong;
}

.expo-workspaces-name-entry#selected {
  color: $text;
  border-color: $accent_strong;
}

.workspace-thumbnail-indicator {
  border: 2px solid $accent_strong;
  border-radius: 0;
}

.tile-preview,
.tile-preview-left,
.tile-preview-right,
.tile-hud,
.tile-hud-left,
.tile-hud-right {
  background-color: alpha($accent_strong, 0.22);
  border: 1px solid $accent_strong;
  border-radius: 0;
}

.tile-preview-left.on-primary,
.tile-preview-right.on-primary,
.tile-preview.on-primary {
  border: 1px solid $focus;
}

.popup-menu {
  color: $text;
  min-width: 300px;
}

.popup-menu-content,
.cinnamon-menu {
  background-color: $surface_raised;
  border: 1px solid $border;
  border-radius: 0;
  padding: 4px;
  color: $text;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
}

.popup-menu-boxpointer,
.candidate-popup-boxpointer {
  -arrow-border-radius: 0;
  -arrow-background-color: $surface_raised;
  -arrow-border-width: 1px;
  -arrow-border-color: $border;
  -arrow-base: 0;
  -arrow-rise: 0;
  -arrow-box-shadow: none;
}

.popup-separator-menu-item {
  height: 1px;
  margin: 4px 8px;
  background-color: $border;
  border: 0;
}

.popup-sub-menu {
  background-color: $surface;
  border: 0;
  border-top: 1px solid $border;
  border-radius: 0;
  padding: 2px;
}

.popup-menu-item {
  min-height: 32px;
  padding: 4px 10px;
  spacing: 8px;
  color: $text;
  background-color: transparent;
  border: 0;
  border-left: 2px solid transparent;
  border-radius: 0;
}

.popup-menu-item:hover,
.popup-menu-item:focus {
  background-color: $surface;
  border-left-color: $accent;
  color: $text;
}

.popup-menu-item:active,
.popup-menu-item:checked,
.popup-menu-item.selected {
  background-color: $accent_strong;
  border-left-color: $accent_strong;
  color: $washi_50;
}

.popup-menu-item:insensitive {
  color: $ash_500;
  border-left-color: transparent;
}

.popup-menu-item .popup-menu-icon {
  icon-size: 16px;
  color: $text_muted;
}

.popup-menu-item:hover .popup-menu-icon,
.popup-menu-item:checked .popup-menu-icon {
  color: inherit;
}

.popup-subtitle-menu-item {
  color: $text_muted;
  font-size: 9pt;
}

.popup-menu-arrow {
  icon-size: 12px;
  color: $text_muted;
}

.popup-menu-item:hover .popup-menu-arrow {
  color: $washi_50;
}

.menu-favorites-box {
  padding: 6px;
  background-color: $surface;
  border: 1px solid $border;
  border-radius: 0;
}

.menu-favorites-button {
  padding: 6px;
  border: 1px solid transparent;
  border-radius: 0;
}

.menu-favorites-button:hover {
  background-color: $surface_raised;
  border-color: $border;
}

.menu-categories-box {
  padding: 6px 0;
  background-color: $surface;
  border-right: 1px solid $border;
}

.menu-category-button {
  min-height: 32px;
  padding: 4px 10px;
  color: $text_muted;
  border-left: 2px solid transparent;
  border-radius: 0;
}

.menu-category-button:hover,
.menu-category-button-hover {
  background-color: $surface_raised;
  border-left-color: $accent;
  color: $text;
}

.menu-category-button-selected,
.menu-category-button-greyed {
  background-color: $surface_raised;
  border-left-color: $accent_strong;
  color: $text;
}

.menu-category-button-label:ltr,
.menu-category-button-label:rtl {
  padding-left: 6px;
}

.menu-applications-box {
  background-color: $bg_alt;
  padding: 6px;
}

.menu-application-button {
  min-height: 32px;
  padding: 4px 8px;
  color: $text;
  background-color: transparent;
  border: 1px solid transparent;
  border-radius: 0;
}

.menu-application-button:hover,
.menu-application-button-selected {
  background-color: $surface_raised;
  border-color: $border;
  color: $text;
}

.menu-application-button-highlight {
  background-color: $accent_strong;
  color: $washi_50;
}

.menu-application-button-label:ltr,
.menu-application-button-label:rtl {
  padding-left: 6px;
}

.menu-search-box {
  padding: 6px;
  background-color: $surface;
  border-bottom: 1px solid $border;
}

.menu-search-entry-icon {
  icon-size: 16px;
  color: $text_muted;
}

#menu-search-entry {
  min-height: 30px;
  padding: 4px 8px;
  color: $text;
  background-color: $bg_alt;
  border: 1px solid $border;
  border-radius: 0;
  caret-color: $focus;
  selection-background-color: $accent_strong;
  selected-color: $washi_50;
}

#menu-search-entry:focus {
  border: 2px solid $focus;
}

.menu-selected-app-title {
  color: $text_muted;
  font-size: 9pt;
}

.menu-selected-app-description {
  color: $text_muted;
  font-size: 9pt;
}

.menu-selected-app-box {
  padding: 6px 10px;
  background-color: $surface;
  border-top: 1px solid $border;
}

.menu-user-avatar {
  border: 1px solid $border_strong;
  border-radius: 0;
}

.calendar {
  background-color: $surface_raised;
  border: 1px solid $border;
  border-radius: 0;
  padding: 6px;
  color: $text;
  font-family: $mono_font_family;
  font-size: 9pt;
}

.calendar-month-label {
  color: $text;
  font-family: $mono_font_family;
  font-size: 10pt;
  font-weight: 600;
  padding: 4px 0;
}

.calendar-day-base {
  min-width: 26px;
  min-height: 24px;
  padding: 2px;
  color: $text_muted;
  background-color: transparent;
  border: 1px solid transparent;
  border-radius: 0;
  text-align: center;
}

.calendar-day-base:hover,
.calendar-day-base:focus {
  background-color: $surface;
  border-color: $border;
  color: $text;
}

.calendar-day-base:active,
.calendar-day-base:selected {
  background-color: $accent_strong;
  border-color: $accent_strong;
  color: $washi_50;
}

.calendar-day-heading {
  color: $text_muted;
  font-size: 8pt;
  padding: 3px 0;
}

.calendar-week-number {
  color: $ash_500;
  font-size: 8pt;
}

.calendar-today {
  color: $accent;
  border: 1px solid $accent;
  font-weight: 600;
}

.calendar-other-month-day {
  color: $ash_500;
}

.calendar-event-day {
  color: $warning;
  border-bottom: 2px solid $warning;
}

.datemenu-today-button,
.datemenu-calendar-column,
.datemenu-displays-box {
  color: $text;
}

.datemenu-today-button {
  padding: 6px 8px;
  border: 1px solid $border;
  border-radius: 0;
  background-color: $surface;
}

.datemenu-today-button:hover {
  background-color: $surface_raised;
}

.datemenu-today-button .date-label {
  color: $text;
  font-family: $mono_font_family;
  font-size: 11pt;
  font-weight: 600;
}

.datemenu-today-button .day-label {
  color: $text_muted;
  font-size: 9pt;
}

.datemenu-calendar-column {
  border: 0;
  padding: 0 4px;
}

.datemenu-displays-box {
  border: 0;
  spacing: 4px;
}

.notification,
.notification-banner,
.notification-banner:hover,
.notification-banner:focus {
  width: 320px;
  background-color: $surface_raised;
  color: $text;
  border: 1px solid $border;
  border-left: 3px solid $accent;
  border-radius: 0;
  padding: 8px 10px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
}

.notification:hover {
  border-color: $border_strong;
  border-left-color: $accent_hover;
}

.notification.multi-line {
  border-left: 3px solid $accent;
}

.notification .notification-title {
  color: $text;
  font-weight: 600;
  font-size: 10pt;
}

.notification .notification-body,
.notification .notification-message {
  color: $text_muted;
  font-size: 9pt;
}

.notification .notification-actions {
  spacing: 4px;
  border-top: 1px solid $border;
  padding-top: 6px;
  margin-top: 6px;
}

.notification-button,
.notification-icon-button,
.sound-button {
  min-height: 24px;
  padding: 3px 8px;
  color: $text;
  background-color: $surface;
  border: 1px solid $border;
  border-radius: 2px;
  transition-duration: 120ms;
}

.notification-button:hover,
.notification-icon-button:hover,
.sound-button:hover {
  background-color: $surface_raised;
  border-color: $accent;
}

.notification-button:focus,
.notification-icon-button:focus,
.sound-button:focus {
  border-color: $focus;
  box-shadow: inset 0 0 0 1px $focus;
}

.notification-button:active,
.notification-icon-button:active,
.sound-button:active {
  background-color: $accent_strong;
  border-color: $accent_strong;
  color: $washi_50;
}

.notification-icon-button > StIcon {
  icon-size: 16px;
}

.notification-close-button {
  color: $text_muted;
  icon-size: 14px;
}

.notification-close-button:hover {
  color: $danger;
}

.modal-dialog,
.modal-dialog-content-box {
  background-color: $surface_raised;
  color: $text;
  border: 1px solid $border_strong;
  border-radius: 4px;
  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55);
}

.modal-dialog {
  max-width: 560px;
  min-width: 320px;
}

.modal-dialog-content-box {
  padding: 24px;
}

.modal-dialog .heading {
  color: $text;
  font-size: 14pt;
  font-weight: 600;
}

.modal-dialog .message {
  color: $text_muted;
  font-size: 10pt;
}

.modal-dialog-button-box {
  padding: 12px 24px 20px;
  spacing: 8px;
  border: 0;
}

.modal-dialog-button-box .modal-dialog-button {
  min-height: 30px;
  min-width: 96px;
  padding: 4px 12px;
  background-color: $surface;
  color: $text;
  border: 1px solid $border;
  border-radius: 2px;
}

.modal-dialog-button-box .modal-dialog-button:hover {
  background-color: $surface_raised;
  border-color: $accent;
}

.modal-dialog-button-box .modal-dialog-button:focus {
  border-color: $focus;
  box-shadow: inset 0 0 0 1px $focus;
}

.modal-dialog-button-box .modal-dialog-button:active {
  background-color: $accent_strong;
  color: $washi_50;
  border-color: $accent_strong;
}

.modal-dialog-button-box .modal-dialog-button:insensitive {
  color: $ash_500;
  border-color: $border;
}

.tooltip,
.tooltip-box {
  background-color: $surface;
  color: $text;
  border: 1px solid $border_strong;
  border-radius: 0;
  padding: 6px 8px;
  font-size: 9pt;
}

.tooltip-label {
  color: $text;
}

.osd-window {
  background-color: alpha($bg_alt, 0.96);
  color: $text;
  border: 1px solid $border;
  border-radius: 0;
  padding: 12px 18px;
  spacing: 10px;
}

.osd-monitor-label {
  background-color: alpha($bg_alt, 0.96);
  color: $washi_50;
  border: 1px solid $border_strong;
  border-radius: 0;
  padding: 12px 18px;
  font-family: $mono_font_family;
  font-size: 18pt;
}

.osd-window .level-bar {
  background-color: $surface_raised;
  border: 0;
  border-radius: 0;
  height: 4px;
}

.osd-window .level-bar .level-bar-fill {
  background-color: $accent_strong;
  border-radius: 0;
}

.switcher-list {
  background-color: $surface_raised;
  border: 1px solid $border;
  border-radius: 0;
  padding: 8px;
  color: $text;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
}

.switcher-list-item-container {
  spacing: 8px;
}

.switcher-list .item-box {
  padding: 6px;
  border: 1px solid transparent;
  border-radius: 0;
  color: $text_muted;
}

.switcher-list .item-box:hover {
  background-color: $surface;
  border-color: $border;
}

.switcher-list .item-box:selected,
.switcher-list .item-box:outlined {
  background-color: $surface_raised;
  border-color: $accent_strong;
  color: $text;
}

.switcher-list .item-box:selected .label {
  color: $text;
}

.switcher-list .thumbnail-box {
  padding: 2px;
  spacing: 4px;
}

.switcher-list .thumbnail {
  border: 1px solid $border;
  border-radius: 0;
}

.switcher-list .separator {
  width: 1px;
  background-color: $border;
}

.switcher-arrow {
  border-color: transparent;
  color: $text_muted;
}

.switcher-arrow:highlighted {
  border-color: transparent;
  color: $text;
}

.switcher-preview-backdrop {
  background-color: alpha($bg_alt, 0.80);
}

.overview-controls {
  background-color: transparent;
}

.window-caption {
  background-color: $surface_raised;
  color: $text;
  border: 1px solid $border;
  border-radius: 0;
  padding: 3px 8px;
  font-size: 9pt;
}

.window-caption#selected {
  background-color: $accent_strong;
  color: $washi_50;
  border-color: $accent_strong;
}

.window-close {
  background-color: $surface_raised;
  color: $text;
  border: 1px solid $border;
  border-radius: 0;
  padding: 3px;
}

.window-close:hover {
  background-color: $danger_strong;
  border-color: $danger_strong;
  color: $washi_50;
}

.window-close:active {
  background-color: $danger;
  border-color: $danger;
}

.resize-popup {
  background-color: $surface_raised;
  border: 1px solid $border;
  border-radius: 0;
  padding: 5px;
}

.lightbox {
  background-color: rgba(0, 0, 0, 0.55);
}

.ripple-box {
  width: 52px;
  height: 52px;
  background-color: alpha($accent_strong, 0.30);
  border: 2px solid $accent;
  border-radius: 0;
}

.sound-player {
  background-color: $surface_raised;
  border: 1px solid $border;
  border-radius: 0;
  padding: 8px;
  color: $text;
}

.sound-player .slider {
  height: 4px;
  background-color: $surface;
  border: 0;
  border-radius: 0;
}

.sound-player .slider .slider-fill {
  background-color: $accent_strong;
}

.sound-player .slider .slider-handle {
  width: 12px;
  height: 12px;
  background-color: $accent;
  border: 1px solid $accent_pressed;
  border-radius: 6px;
}

.sound-player StButton {
  color: $text;
  border: 1px solid transparent;
  border-radius: 2px;
  padding: 3px;
}

.sound-player StButton:hover {
  background-color: $surface;
  border-color: $border;
}

.sound-player .track-title {
  color: $text;
  font-weight: 600;
}

.sound-player .track-artist,
.sound-player .track-album {
  color: $text_muted;
  font-size: 9pt;
}

.keyboard-key {
  background-color: $surface_raised;
  color: $text;
  border: 1px solid $border;
  border-radius: 2px;
  min-width: 28px;
  min-height: 28px;
}

.keyboard-key:checked,
.keyboard-key:active {
  background-color: $accent_strong;
  color: $washi_50;
  border-color: $accent_strong;
}

.keyboard-layout-title {
  color: $text;
  font-weight: 600;
}

.keyboard-subkeys {
  background-color: $surface_raised;
  border: 1px solid $border;
  border-radius: 0;
  padding: 4px;
}

.app-switcher-button {
  border: 1px solid transparent;
  border-radius: 0;
  padding: 6px;
}

.app-switcher-button:hover {
  background-color: $surface;
  border-color: $border;
}

.app-switcher-button:selected {
  background-color: $surface_raised;
  border-color: $accent_strong;
}

.app-well-app .overview-icon,
.app-well-app-running-dot {
  color: $text;
}

.app-well-app-running-dot {
  background-color: $accent_strong;
  border-radius: 0;
}

.search-entry {
  color: $text;
  background-color: $bg_alt;
  border: 1px solid $border;
  border-radius: 0;
  padding: 6px 10px;
  caret-color: $focus;
  selection-background-color: $accent_strong;
  selected-color: $washi_50;
}

.search-entry:focus {
  border: 2px solid $focus;
}

.search-entry-icon {
  icon-size: 16px;
  color: $text_muted;
}

.search-section-content {
  background-color: $surface_raised;
  border: 1px solid $border;
  border-radius: 0;
  padding: 6px;
}

.search-section-separator {
  height: 1px;
  background-color: $border;
}

.search-result-content {
  padding: 4px;
}

.search-result-content:hover {
  background-color: $surface;
}

.search-result-content:selected {
  background-color: $accent_strong;
  color: $washi_50;
}

.list-search-result-title {
  color: $text;
  font-weight: 600;
}

.list-search-result-description {
  color: $text_muted;
  font-size: 9pt;
}

.list-search-result:hover {
  background-color: $surface;
}

.cinnamon-settings-window,
.cs-category-view,
.cs-pages {
  background-color: $bg;
  color: $text;
}

.cs-header {
  background-color: $surface;
  border-bottom: 1px solid $border;
}

.cs-header .title {
  color: $text;
  font-size: 14pt;
  font-weight: 600;
}

.cs-category-button {
  border: 1px solid transparent;
  border-radius: 0;
  padding: 6px;
  color: $text_muted;
}

.cs-category-button:hover {
  background-color: $surface;
  border-color: $border;
  color: $text;
}

.cs-category-button:selected {
  background-color: $surface_raised;
  border-left: 2px solid $accent_strong;
  color: $text;
}

/* Focus visibility is intentionally stronger than decoration. */
.popup-menu-item:focus,
.menu-application-button:focus,
.menu-category-button:focus,
.notification-button:focus,
.modal-dialog-button-box .modal-dialog-button:focus,
.osd-window:focus {
  border-color: $focus;
  box-shadow: inset 0 0 0 1px $focus;
}
