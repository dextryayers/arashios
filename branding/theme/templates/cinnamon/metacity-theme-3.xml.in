<?xml version="1.0" encoding="UTF-8"?>
<metacity_theme>
<info>
  <name>ArashiKage</name>
  <author>ArashiOS Project</author>
  <copyright>GPL-3.0-or-later</copyright>
  <date>2026-10-21</date>
  <description>Kage window decorations for Cinnamon and Muffin.</description>
</info>

<constant name="C_titlebar" value="$surface"/>
<constant name="C_titlebar_inactive" value="$bg"/>
<constant name="C_border_active" value="$accent_strong"/>
<constant name="C_border_inactive" value="$border"/>
<constant name="C_title" value="$text"/>
<constant name="C_title_inactive" value="$text_muted"/>
<constant name="C_icon" value="$text"/>
<constant name="C_icon_inactive" value="$text_muted"/>
<constant name="C_button_hover" value="$surface_raised"/>
<constant name="C_button_pressed" value="$accent_strong"/>
<constant name="C_icon_pressed" value="$washi_50"/>

<frame_geometry name="normal" title_scale="medium" rounded_top_left="false" rounded_top_right="false" rounded_bottom_left="false" rounded_bottom_right="false">
  <distance name="left_width" value="2"/>
  <distance name="right_width" value="2"/>
  <distance name="bottom_height" value="2"/>
  <distance name="left_titlebar_edge" value="0"/>
  <distance name="right_titlebar_edge" value="0"/>
  <distance name="title_vertical_pad" value="0"/>
  <border name="title_border" left="10" right="6" top="4" bottom="4"/>
  <border name="button_border" left="0" right="0" top="4" bottom="4"/>
  <distance name="button_width" value="28"/>
  <distance name="button_height" value="22"/>
</frame_geometry>

<frame_geometry name="maximized" parent="normal" rounded_top_left="false" rounded_top_right="false" rounded_bottom_left="false" rounded_bottom_right="false">
  <distance name="left_width" value="0"/>
  <distance name="right_width" value="0"/>
  <distance name="bottom_height" value="1"/>
</frame_geometry>

<frame_geometry name="tiled_left" parent="maximized">
  <distance name="left_width" value="0"/>
  <distance name="right_width" value="2"/>
</frame_geometry>

<frame_geometry name="tiled_right" parent="maximized">
  <distance name="left_width" value="2"/>
  <distance name="right_width" value="0"/>
</frame_geometry>

<frame_geometry name="utility" parent="normal" title_scale="small">
  <distance name="left_width" value="2"/>
  <distance name="right_width" value="2"/>
  <distance name="bottom_height" value="2"/>
</frame_geometry>

<frame_geometry name="attached" parent="normal">
  <distance name="left_width" value="0"/>
  <distance name="right_width" value="0"/>
  <distance name="bottom_height" value="0"/>
  <distance name="left_titlebar_edge" value="0"/>
  <distance name="right_titlebar_edge" value="0"/>
  <distance name="title_vertical_pad" value="0"/>
</frame_geometry>

<frame_geometry name="border" has_title="false">
  <distance name="left_width" value="2"/>
  <distance name="right_width" value="2"/>
  <distance name="bottom_height" value="2"/>
  <distance name="left_titlebar_edge" value="0"/>
  <distance name="right_titlebar_edge" value="0"/>
  <distance name="button_width" value="0"/>
  <distance name="button_height" value="0"/>
  <distance name="title_vertical_pad" value="0"/>
</frame_geometry>

<draw_ops name="entire_background_focused">
  <rectangle color="C_border_active" x="0" y="0" width="width" height="height" filled="true"/>
</draw_ops>

<draw_ops name="entire_background_unfocused">
  <rectangle color="C_border_inactive" x="0" y="0" width="width" height="height" filled="true"/>
</draw_ops>

<draw_ops name="titlebar_fill_focused">
  <rectangle color="C_titlebar" x="0" y="0" width="width" height="height" filled="true"/>
</draw_ops>

<draw_ops name="titlebar_fill_unfocused">
  <rectangle color="C_titlebar_inactive" x="0" y="0" width="width" height="height" filled="true"/>
</draw_ops>

<draw_ops name="title_focused">
  <title version=">= 3.1" x="10" y="((height - title_height) / 2)" color="C_title" ellipsize_width="width - 50"/>
</draw_ops>

<draw_ops name="title_unfocused">
  <title version=">= 3.1" x="10" y="((height - title_height) / 2)" color="C_title_inactive" ellipsize_width="width - 50"/>
</draw_ops>

<draw_ops name="button_hover">
  <rectangle color="C_button_hover" x="3" y="3" width="width - 6" height="height - 6" filled="true"/>
</draw_ops>

<draw_ops name="button_pressed">
  <rectangle color="C_button_pressed" x="3" y="3" width="width - 6" height="height - 6" filled="true"/>
</draw_ops>

<draw_ops name="close_focused">
  <include name="button_hover"/>
  <line color="C_icon" x1="8" y1="6" x2="width - 8" y2="height - 6"/>
  <line color="C_icon" x1="width - 8" y1="6" x2="8" y2="height - 6"/>
</draw_ops>

<draw_ops name="close_prelight">
  <include name="button_hover"/>
  <line color="C_icon" x1="8" y1="6" x2="width - 8" y2="height - 6"/>
  <line color="C_icon" x1="width - 8" y1="6" x2="8" y2="height - 6"/>
</draw_ops>

<draw_ops name="close_pressed">
  <include name="button_pressed"/>
  <line color="C_icon_pressed" x1="8" y1="6" x2="width - 8" y2="height - 6"/>
  <line color="C_icon_pressed" x1="width - 8" y1="6" x2="8" y2="height - 6"/>
</draw_ops>

<draw_ops name="close_unfocused">
  <line color="C_icon_inactive" x1="8" y1="6" x2="width - 8" y2="height - 6"/>
  <line color="C_icon_inactive" x1="width - 8" y1="6" x2="8" y2="height - 6"/>
</draw_ops>

<draw_ops name="minimize_focused">
  <line color="C_icon" x1="8" y1="height / 2" x2="width - 8" y2="height / 2"/>
</draw_ops>

<draw_ops name="minimize_prelight">
  <include name="button_hover"/>
  <line color="C_icon" x1="8" y1="height / 2" x2="width - 8" y2="height / 2"/>
</draw_ops>

<draw_ops name="minimize_pressed">
  <include name="button_pressed"/>
  <line color="C_icon_pressed" x1="8" y1="height / 2" x2="width - 8" y2="height / 2"/>
</draw_ops>

<draw_ops name="minimize_unfocused">
  <line color="C_icon_inactive" x1="8" y1="height / 2" x2="width - 8" y2="height / 2"/>
</draw_ops>

<draw_ops name="maximize_focused">
  <rectangle color="C_icon" x="8" y="6" width="width - 16" height="height - 12" filled="false"/>
</draw_ops>

<draw_ops name="maximize_prelight">
  <include name="button_hover"/>
  <rectangle color="C_icon" x="8" y="6" width="width - 16" height="height - 12" filled="false"/>
</draw_ops>

<draw_ops name="maximize_pressed">
  <include name="button_pressed"/>
  <rectangle color="C_icon_pressed" x="8" y="6" width="width - 16" height="height - 12" filled="false"/>
</draw_ops>

<draw_ops name="maximize_unfocused">
  <rectangle color="C_icon_inactive" x="8" y="6" width="width - 16" height="height - 12" filled="false"/>
</draw_ops>

<draw_ops name="restore_focused">
  <rectangle color="C_icon" x="7" y="8" width="width - 18" height="height - 14" filled="false"/>
  <rectangle color="C_icon" x="11" y="4" width="width - 18" height="height - 14" filled="false"/>
</draw_ops>

<draw_ops name="restore_prelight">
  <include name="button_hover"/>
  <rectangle color="C_icon" x="7" y="8" width="width - 18" height="height - 14" filled="false"/>
  <rectangle color="C_icon" x="11" y="4" width="width - 18" height="height - 14" filled="false"/>
</draw_ops>

<draw_ops name="restore_pressed">
  <include name="button_pressed"/>
  <rectangle color="C_icon_pressed" x="7" y="8" width="width - 18" height="height - 14" filled="false"/>
  <rectangle color="C_icon_pressed" x="11" y="4" width="width - 18" height="height - 14" filled="false"/>
</draw_ops>

<draw_ops name="restore_unfocused">
  <rectangle color="C_icon_inactive" x="7" y="8" width="width - 18" height="height - 14" filled="false"/>
  <rectangle color="C_icon_inactive" x="11" y="4" width="width - 18" height="height - 14" filled="false"/>
</draw_ops>

<draw_ops name="blank"/>

<draw_ops name="border_tiled_left_focused">
  <line color="C_border_active" x1="width - 1" y1="0" x2="width - 1" y2="height"/>
</draw_ops>

<draw_ops name="border_tiled_left_unfocused">
  <line color="C_border_inactive" x1="width - 1" y1="0" x2="width - 1" y2="height"/>
</draw_ops>

<draw_ops name="border_tiled_right_focused">
  <line color="C_border_active" x1="0" y1="0" x2="0" y2="height"/>
</draw_ops>

<draw_ops name="border_tiled_right_unfocused">
  <line color="C_border_inactive" x1="0" y1="0" x2="0" y2="height"/>
</draw_ops>

<frame_style name="normal_focused" geometry="normal">
  <piece position="entire_background" draw_ops="entire_background_focused"/>
  <piece position="titlebar" draw_ops="titlebar_fill_focused"/>
  <piece position="title" draw_ops="title_focused"/>
  <button function="close" state="normal" draw_ops="close_unfocused"/>
  <button function="close" state="prelight" draw_ops="close_prelight"/>
  <button function="close" state="pressed" draw_ops="close_pressed"/>
  <button function="maximize" state="normal" draw_ops="maximize_focused"/>
  <button function="maximize" state="prelight" draw_ops="maximize_prelight"/>
  <button function="maximize" state="pressed" draw_ops="maximize_pressed"/>
  <button function="minimize" state="normal" draw_ops="minimize_focused"/>
  <button function="minimize" state="prelight" draw_ops="minimize_prelight"/>
  <button function="minimize" state="pressed" draw_ops="minimize_pressed"/>
  <button function="menu" state="normal" draw_ops="blank"/>
  <button function="menu" state="pressed" draw_ops="blank"/>
  <button function="shade" state="normal" draw_ops="blank"/>
  <button function="unshade" state="normal" draw_ops="blank"/>
  <button function="above" state="normal" draw_ops="blank"/>
  <button function="above" state="pressed" draw_ops="blank"/>
  <button function="unabove" state="normal" draw_ops="blank"/>
  <button function="unabove" state="pressed" draw_ops="blank"/>
  <button function="stick" state="normal" draw_ops="blank"/>
  <button function="unstick" state="normal" draw_ops="blank"/>
</frame_style>

<frame_style name="normal_unfocused" geometry="normal" parent="normal_focused">
  <piece position="entire_background" draw_ops="entire_background_unfocused"/>
  <piece position="titlebar" draw_ops="titlebar_fill_unfocused"/>
  <piece position="title" draw_ops="title_unfocused"/>
  <button function="close" state="normal" draw_ops="close_unfocused"/>
  <button function="close" state="prelight" draw_ops="close_unfocused"/>
  <button function="close" state="pressed" draw_ops="close_unfocused"/>
  <button function="maximize" state="normal" draw_ops="maximize_unfocused"/>
  <button function="maximize" state="prelight" draw_ops="maximize_unfocused"/>
  <button function="maximize" state="pressed" draw_ops="maximize_unfocused"/>
  <button function="minimize" state="normal" draw_ops="minimize_unfocused"/>
  <button function="minimize" state="prelight" draw_ops="minimize_unfocused"/>
  <button function="minimize" state="pressed" draw_ops="minimize_unfocused"/>
</frame_style>

<frame_style name="maximized_focused" geometry="maximized" parent="normal_focused">
  <piece position="entire_background" draw_ops="entire_background_focused"/>
  <piece position="titlebar" draw_ops="titlebar_fill_focused"/>
  <piece position="title" draw_ops="title_focused"/>
  <button function="maximize" state="normal" draw_ops="restore_focused"/>
  <button function="maximize" state="prelight" draw_ops="restore_prelight"/>
  <button function="maximize" state="pressed" draw_ops="restore_pressed"/>
</frame_style>

<frame_style name="maximized_unfocused" geometry="maximized" parent="normal_unfocused">
  <piece position="entire_background" draw_ops="entire_background_unfocused"/>
  <piece position="titlebar" draw_ops="titlebar_fill_unfocused"/>
  <piece position="title" draw_ops="title_unfocused"/>
  <button function="maximize" state="normal" draw_ops="restore_unfocused"/>
  <button function="maximize" state="prelight" draw_ops="restore_unfocused"/>
  <button function="maximize" state="pressed" draw_ops="restore_unfocused"/>
</frame_style>

<frame_style name="tiled_left_focused" geometry="tiled_left" parent="maximized_focused">
  <piece position="overlay" draw_ops="border_tiled_left_focused"/>
  <button function="maximize" state="normal" draw_ops="maximize_focused"/>
  <button function="maximize" state="prelight" draw_ops="maximize_prelight"/>
  <button function="maximize" state="pressed" draw_ops="maximize_pressed"/>
</frame_style>

<frame_style name="tiled_left_unfocused" geometry="tiled_left" parent="maximized_unfocused">
  <piece position="overlay" draw_ops="border_tiled_left_unfocused"/>
  <button function="maximize" state="normal" draw_ops="maximize_unfocused"/>
  <button function="maximize" state="prelight" draw_ops="maximize_unfocused"/>
  <button function="maximize" state="pressed" draw_ops="maximize_unfocused"/>
</frame_style>

<frame_style name="tiled_right_focused" geometry="tiled_right" parent="maximized_focused">
  <piece position="overlay" draw_ops="border_tiled_right_focused"/>
  <button function="maximize" state="normal" draw_ops="maximize_focused"/>
  <button function="maximize" state="prelight" draw_ops="maximize_prelight"/>
  <button function="maximize" state="pressed" draw_ops="maximize_pressed"/>
</frame_style>

<frame_style name="tiled_right_unfocused" geometry="tiled_right" parent="maximized_unfocused">
  <piece position="overlay" draw_ops="border_tiled_right_unfocused"/>
  <button function="maximize" state="normal" draw_ops="maximize_unfocused"/>
  <button function="maximize" state="prelight" draw_ops="maximize_unfocused"/>
  <button function="maximize" state="pressed" draw_ops="maximize_unfocused"/>
</frame_style>

<frame_style name="utility_focused" geometry="utility" parent="normal_focused"/>
<frame_style name="utility_unfocused" geometry="utility" parent="normal_unfocused"/>
<frame_style name="attached_focused" geometry="attached" parent="normal_focused"/>
<frame_style name="attached_unfocused" geometry="attached" parent="normal_unfocused"/>

<frame_style name="border" geometry="border" parent="normal_focused">
  <piece position="entire_background" draw_ops="entire_background_focused"/>
  <piece position="title" draw_ops="blank"/>
</frame_style>

<frame_style name="blank" geometry="normal">
  <button function="close" state="normal" draw_ops="blank"/>
  <button function="close" state="pressed" draw_ops="blank"/>
  <button function="maximize" state="normal" draw_ops="blank"/>
  <button function="maximize" state="pressed" draw_ops="blank"/>
  <button function="minimize" state="normal" draw_ops="blank"/>
  <button function="minimize" state="pressed" draw_ops="blank"/>
</frame_style>

<frame_style_set name="normal">
  <frame focus="yes" state="normal" resize="both" style="normal_focused"/>
  <frame focus="no" state="normal" resize="both" style="normal_unfocused"/>
  <frame focus="yes" state="maximized" style="maximized_focused"/>
  <frame focus="no" state="maximized" style="maximized_unfocused"/>
  <frame focus="yes" state="shaded" style="normal_focused"/>
  <frame focus="no" state="shaded" style="normal_unfocused"/>
  <frame focus="yes" state="maximized_and_shaded" style="maximized_focused"/>
  <frame focus="no" state="maximized_and_shaded" style="maximized_unfocused"/>
  <frame version=">= 3.3" focus="yes" state="tiled_left" style="tiled_left_focused"/>
  <frame version=">= 3.3" focus="no" state="tiled_left" style="tiled_left_unfocused"/>
  <frame version=">= 3.3" focus="yes" state="tiled_right" style="tiled_right_focused"/>
  <frame version=">= 3.3" focus="no" state="tiled_right" style="tiled_right_unfocused"/>
  <frame version=">= 3.3" focus="yes" state="tiled_left_and_shaded" style="tiled_left_focused"/>
  <frame version=">= 3.3" focus="no" state="tiled_left_and_shaded" style="tiled_left_unfocused"/>
  <frame version=">= 3.3" focus="yes" state="tiled_right_and_shaded" style="tiled_right_focused"/>
  <frame version=">= 3.3" focus="no" state="tiled_right_and_shaded" style="tiled_right_unfocused"/>
</frame_style_set>

<frame_style_set name="utility">
  <frame focus="yes" state="normal" resize="both" style="utility_focused"/>
  <frame focus="no" state="normal" resize="both" style="utility_unfocused"/>
  <frame focus="yes" state="maximized" style="blank"/>
  <frame focus="no" state="maximized" style="blank"/>
  <frame focus="yes" state="shaded" style="utility_focused"/>
  <frame focus="no" state="shaded" style="utility_unfocused"/>
  <frame focus="yes" state="maximized_and_shaded" style="blank"/>
  <frame focus="no" state="maximized_and_shaded" style="blank"/>
</frame_style_set>

<frame_style_set name="attached">
  <frame focus="yes" state="normal" resize="both" style="attached_focused"/>
  <frame focus="no" state="normal" resize="both" style="attached_unfocused"/>
  <frame focus="yes" state="maximized" style="blank"/>
  <frame focus="no" state="maximized" style="blank"/>
  <frame focus="yes" state="shaded" style="blank"/>
  <frame focus="no" state="shaded" style="blank"/>
</frame_style_set>

<frame_style_set name="border">
  <frame focus="yes" state="normal" resize="both" style="border"/>
  <frame focus="no" state="normal" resize="both" style="border"/>
  <frame focus="yes" state="maximized" style="border"/>
  <frame focus="no" state="maximized" style="border"/>
  <frame focus="yes" state="shaded" style="border"/>
  <frame focus="no" state="shaded" style="border"/>
  <frame focus="yes" state="maximized_and_shaded" style="border"/>
  <frame focus="no" state="maximized_and_shaded" style="border"/>
</frame_style_set>

<window type="normal" style_set="normal"/>
<window type="dialog" style_set="normal"/>
<window type="modal_dialog" style_set="normal"/>
<window type="menu" style_set="normal"/>
<window type="utility" style_set="utility"/>
<window type="border" style_set="border"/>
<window version=">= 3.2" type="attached" style_set="attached"/>
</metacity_theme>
