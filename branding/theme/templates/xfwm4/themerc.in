# ArashiOS Kage xfwm4 theme.
# Generated by scripts/generate-theme.py from branding/tokens.json.
# Source template: branding/theme/templates/xfwm4/themerc.in
#
# The titlebar is 30 px, flat, and uses a one-pixel steel border. The active
# window carries a two-pixel vermilion edge on the left so focus is legible
# without relying on color alone.

active_text_color=$text
active_text_shadow_color=$text
inactive_text_color=$text_muted
inactive_text_shadow_color=$text_muted
title_shadow_active=false
title_shadow_inactive=false
full_width_title=true
title_vertical_offset_active=0
title_vertical_offset_inactive=0
button_offset=4
button_spacing=4
shadow_delta_height=2
shadow_delta_width=0
shadow_delta_x=0
shadow_delta_y=4
shadow_opacity=45
show_app_icon=false
show_popup_shadow=true
