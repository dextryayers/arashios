/* ArashiOS Kage GTK3 theme.
 * Generated by scripts/generate-theme.py from branding/tokens.json.
 * Do not edit by hand. Source template: branding/theme/templates/gtk-3.0/gtk.css.in
 */

@define-color theme_bg_color $bg;
@define-color theme_fg_color $text;
@define-color theme_base_color $surface_sunken;
@define-color theme_text_color $text;
@define-color theme_selected_bg_color $accent_strong;
@define-color theme_selected_fg_color $washi_50;
@define-color theme_unfocused_bg_color $bg;
@define-color theme_unfocused_fg_color $text_muted;
@define-color insensitive_fg_color $ash_500;
@define-color borders $border;
@define-color unfocused_borders $border;
@define-color warning_color $warning;
@define-color error_color $danger;
@define-color success_color $success;
@define-color content_view_bg $surface;
@define-color text_view_bg $surface_sunken;
@define-color kage_bg $bg;
@define-color kage_bg_alt $bg_alt;
@define-color kage_surface $surface;
@define-color kage_surface_raised $surface_raised;
@define-color kage_text $text;
@define-color kage_text_muted $text_muted;
@define-color kage_accent $accent;
@define-color kage_accent_strong $accent_strong;
@define-color kage_focus $focus;
@define-color kage_border $border;

* {
  -GtkToolButton-icon-spacing: 4;
  -GtkTextView-error-underline-color: $danger;
  -GtkScrolledWindow-scrollbar-spacing: 0;
  -GtkDialog-button-spacing: 8;
  -GtkDialog-action-area-border: 8;
  outline-style: solid;
  outline-width: 0;
  outline-color: transparent;
  outline-offset: 0;
  background-clip: padding-box;
}

.background,
window,
window.background,
dialog,
.vertical,
.horizontal {
  background-color: $bg;
  color: $text;
  font-family: $gtk_font_family;
  font-size: 11pt;
}

window:backdrop,
dialog:backdrop,
.background:backdrop {
  color: $text_muted;
}

label {
  color: $text;
  caret-color: $focus;
}

label:disabled,
label:backdrop:disabled {
  color: $ash_500;
}

label.dim-label,
.dim-label {
  color: $text_muted;
}

label.error,
.error {
  color: $danger;
}

label.warning,
.warning {
  color: $warning;
}

label.success,
.success {
  color: $success;
}

*:focus {
  outline-style: solid;
  outline-width: 2px;
  outline-color: $focus;
  outline-offset: 2px;
}

*:disabled {
  color: $ash_500;
}

*:selected {
  background-color: $accent_strong;
  color: $washi_50;
}

button,
.button {
  min-height: 30px;
  min-width: 16px;
  padding: 5px 12px;
  border: 1px solid $border;
  border-radius: $radius_sm;
  background-image: none;
  background-color: $surface_raised;
  color: $text;
  box-shadow: none;
  text-shadow: none;
  -gtk-icon-shadow: none;
  transition: background-color 120ms cubic-bezier(0.2, 0, 0, 1),
              border-color 120ms cubic-bezier(0.2, 0, 0, 1);
}

button:hover,
.button:hover {
  background-color: $surface;
  border-color: $accent;
  color: $text;
}

button:active,
button:checked,
.button:active,
.button:checked {
  background-color: $bg_alt;
  border-color: $border_strong;
  color: $text;
}

button:disabled,
.button:disabled {
  background-color: $bg;
  border-color: $border;
  color: $ash_500;
}

button:focus,
.button:focus {
  border-color: $focus;
  box-shadow: inset 0 0 0 1px $focus;
}

button.flat,
button.flat:hover,
.toolbar button.flat {
  background-color: transparent;
  border-color: transparent;
  box-shadow: none;
}

button.flat:hover,
.toolbar button.flat:hover {
  background-color: $surface_raised;
  border-color: $border;
}

button.circular {
  min-width: 30px;
  min-height: 30px;
  padding: 0;
  border-radius: 15px;
}

button.suggested-action,
button.default,
button.text-button.suggested-action {
  background-color: $accent;
  border-color: $accent;
  color: $on_accent;
}

button.suggested-action:hover,
button.default:hover {
  background-color: $accent_hover;
  border-color: $accent_hover;
}

button.suggested-action:active,
button.default:active {
  background-color: $accent_pressed;
  border-color: $accent_pressed;
}

button.destructive-action {
  background-color: $danger_strong;
  border-color: $danger_strong;
  color: $washi_50;
}

button.destructive-action:hover {
  background-color: $danger;
  border-color: $danger;
  color: $bg_alt;
}

entry,
entry.flat,
spinbutton,
spinbutton.vertical,
combobox button.combo {
  min-height: 30px;
  padding: 5px 9px;
  border: 1px solid $border;
  border-radius: $radius_sm;
  background-image: none;
  background-color: $bg_alt;
  color: $text;
  caret-color: $focus;
}

entry:hover,
spinbutton:hover,
combobox button.combo:hover {
  border-color: $border_strong;
}

entry:focus,
entry:focus-within,
spinbutton:focus,
combobox button.combo:focus {
  border-color: $focus;
  box-shadow: inset 0 0 0 1px $focus;
}

entry:disabled,
spinbutton:disabled,
combobox button.combo:disabled {
  background-color: $bg;
  color: $ash_500;
  border-color: $border;
}

entry:selected,
entry selection,
textview selection,
label selection {
  background-color: $accent_strong;
  color: $washi_50;
}

entry image,
entry undershoot,
entry scrollbar {
  color: $text_muted;
  background-color: transparent;
}

combobox arrow {
  min-width: 16px;
  min-height: 16px;
  color: $text_muted;
}

menubar,
.menubar {
  background-color: $surface;
  color: $text;
  border-bottom: 1px solid $border;
  padding: 0;
}

menubar > menuitem,
.menubar > menuitem {
  padding: 6px 10px;
  border: 0;
  border-radius: 0;
  background-color: transparent;
  color: $text;
}

menubar > menuitem:hover,
menubar > menuitem:selected {
  background-color: $surface_raised;
  color: $text;
}

menu,
.menu,
.context-menu,
popover.background,
popover > .view,
popover > .background {
  background-color: $surface_raised;
  color: $text;
  border: 1px solid $border;
  border-radius: $radius_md;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
  padding: 4px;
}

menu menuitem,
.menu menuitem,
.context-menu menuitem {
  min-height: 26px;
  padding: 5px 10px;
  border-radius: $radius_sm;
  color: $text;
}

menu menuitem:hover,
menu menuitem:selected,
.menu menuitem:hover,
.context-menu menuitem:hover {
  background-color: $accent_strong;
  color: $washi_50;
}

menu menuitem:disabled,
.menu menuitem:disabled {
  color: $ash_500;
}

menu separator,
.menu separator,
popover separator {
  min-height: 1px;
  margin: 4px 8px;
  background-color: $border;
}

menuitem accelerator,
menu menuitem accelerator {
  color: $text_muted;
}

menu menuitem:hover accelerator {
  color: $washi_50;
}

headerbar,
.titlebar,
headerbar.titlebar,
.titlebar.background {
  min-height: 34px;
  padding: 3px 8px;
  background-image: none;
  background-color: $surface;
  color: $text;
  border-bottom: 1px solid $border;
  box-shadow: none;
  border-radius: 0;
}

headerbar:backdrop,
.titlebar:backdrop {
  background-color: $bg;
  color: $text_muted;
}

headerbar .title,
.titlebar .title {
  color: $text;
  font-weight: 600;
}

headerbar .subtitle,
.titlebar .subtitle {
  color: $text_muted;
  font-size: 9pt;
}

headerbar button,
.titlebar button {
  min-height: 26px;
  padding: 3px 9px;
  background-color: transparent;
  border-color: transparent;
}

headerbar button:hover,
.titlebar button:hover {
  background-color: $surface_raised;
  border-color: $border;
}

toolbar,
.toolbar,
toolbar.vertical {
  background-color: $surface;
  color: $text;
  border: 0;
  padding: 4px;
}

toolbarbutton,
.toolbutton {
  padding: 4px;
  border: 1px solid transparent;
  border-radius: $radius_sm;
  background-color: transparent;
}

toolbarbutton:hover,
.toolbutton:hover {
  background-color: $surface_raised;
  border-color: $border;
}

toolbarbutton:checked,
.toolbutton:checked {
  background-color: $accent_strong;
  border-color: $accent_strong;
  color: $washi_50;
}

popover {
  padding: 4px;
}

popover.background > list,
popover.background > .view,
popover.background > toolbar {
  background-color: transparent;
  border: 0;
}

tooltip,
.tooltip {
  background-color: $surface_raised;
  color: $text;
  border: 1px solid $border_strong;
  border-radius: $radius_sm;
  padding: 4px 8px;
  box-shadow: none;
}

tooltip label {
  color: $text;
}

notebook,
notebook.frame {
  background-color: $bg;
  border: 1px solid $border;
  border-radius: $radius_sm;
}

notebook > header {
  background-color: $surface;
  border: 0;
  border-bottom: 1px solid $border;
}

notebook > header > tabs > tab {
  min-height: 26px;
  padding: 5px 14px;
  margin: 0;
  border: 0;
  border-right: 1px solid $border;
  border-radius: 0;
  background-color: $surface;
  color: $text_muted;
}

notebook > header > tabs > tab:hover {
  background-color: $surface_raised;
  color: $text;
}

notebook > header > tabs > tab:checked,
notebook > header > tabs > tab:active {
  background-color: $surface_raised;
  color: $text;
  box-shadow: inset 0 -2px 0 $accent_strong;
}

notebook > stack {
  background-color: $bg;
}

treeview.view,
treeview,
list,
list.view,
iconview,
.view {
  background-color: $surface;
  color: $text;
  border: 1px solid $border;
  border-radius: $radius_sm;
}

treeview.view:selected,
treeview:selected,
list row:selected,
list.view:selected,
iconview:selected,
.view:selected {
  background-color: $accent_strong;
  color: $washi_50;
}

treeview.view:hover,
list row:hover,
.view:hover {
  background-color: $surface_raised;
}

treeview.view:disabled,
list row:disabled {
  color: $ash_500;
}

treeview.view header button,
treeview header button {
  min-height: 26px;
  padding: 5px 8px;
  border: 0;
  border-right: 1px solid $border;
  border-bottom: 1px solid $border;
  border-radius: 0;
  background-color: $surface_raised;
  color: $text;
  font-weight: 600;
}

treeview.view header button:hover {
  background-color: $surface;
}

treeview.view separator,
list separator {
  background-color: $border;
}

scrolledwindow,
scrolledwindow viewport {
  background-color: transparent;
}

scrollbar {
  background-color: $bg;
  border: 0;
}

scrollbar trough {
  background-color: $surface;
  border: 0;
  border-radius: 0;
}

scrollbar slider {
  min-width: 8px;
  min-height: 32px;
  margin: 2px;
  border: 1px solid $border;
  border-radius: $radius_sm;
  background-color: $border_strong;
}

scrollbar slider:hover {
  background-color: $accent;
  border-color: $accent;
}

scrollbar slider:active {
  background-color: $accent_pressed;
  border-color: $accent_pressed;
}

scrollbar.overlay-indicator:not(.dragging):not(.hovering) slider {
  background-color: $text_muted;
  border-color: transparent;
  opacity: 0.55;
}

separator,
.separator {
  background-color: $border;
  min-width: 1px;
  min-height: 1px;
}

paned > separator {
  background-color: $border;
  min-width: 1px;
  min-height: 1px;
}

frame,
.frame,
frame > border {
  border: 1px solid $border;
  border-radius: $radius_sm;
  background-color: transparent;
}

statusbar,
.statusbar {
  background-color: $surface;
  color: $text_muted;
  border-top: 1px solid $border;
  padding: 4px 8px;
}

infobar,
infobar.info,
infobar.question,
infobar.warning,
infobar.error {
  border: 1px solid $border;
  border-radius: 0;
}

infobar.info {
  background-color: $surface_raised;
  color: $text;
  border-left: 3px solid $accent;
}

infobar.warning {
  background-color: $surface_raised;
  color: $text;
  border-left: 3px solid $warning;
}

infobar.error {
  background-color: $surface_raised;
  color: $text;
  border-left: 3px solid $danger;
}

infobar.success {
  background-color: $surface_raised;
  color: $text;
  border-left: 3px solid $success;
}

infobar label {
  color: inherit;
}

progressbar,
progressbar trough {
  min-height: 6px;
  border: 1px solid $border;
  border-radius: 0;
  background-color: $surface;
}

progressbar progress {
  min-height: 6px;
  border: 0;
  border-radius: 0;
  background-color: $accent_strong;
}

levelbar block,
levelbar trough {
  min-height: 6px;
  border-radius: 0;
}

levelbar block.filled {
  background-color: $success;
  border-color: $success;
}

levelbar block.low {
  background-color: $danger;
}

levelbar block.high {
  background-color: $success;
}

scale trough {
  min-height: 4px;
  border: 0;
  border-radius: 0;
  background-color: $surface_raised;
}

scale highlight {
  background-color: $accent_strong;
  border-radius: 0;
}

scale slider {
  min-width: 14px;
  min-height: 14px;
  margin: -5px;
  border: 1px solid $accent_pressed;
  border-radius: 7px;
  background-color: $accent;
}

scale slider:hover {
  background-color: $accent_hover;
  border-color: $accent_hover;
}

switch {
  min-width: 42px;
  min-height: 22px;
  padding: 2px;
  border: 1px solid $border;
  border-radius: 12px;
  background-color: $surface;
}

switch:checked {
  background-color: $accent_strong;
  border-color: $accent_strong;
}

switch slider {
  min-width: 18px;
  min-height: 18px;
  border: 0;
  border-radius: 9px;
  background-color: $text;
}

switch:checked slider {
  background-color: $washi_50;
}

checkbutton,
radiobutton {
  background-color: transparent;
  color: $text;
}

checkbutton check,
radiobutton radio {
  min-width: 16px;
  min-height: 16px;
  border: 1px solid $border_strong;
  background-color: $surface;
  color: $washi_50;
}

checkbutton check {
  border-radius: $radius_sm;
}

radiobutton radio {
  border-radius: 8px;
}

checkbutton check:checked,
radiobutton radio:checked {
  background-color: $accent_strong;
  border-color: $accent_strong;
}

checkbutton check:indeterminate {
  background-color: $warning;
  border-color: $warning;
}

calendar {
  background-color: $surface;
  color: $text;
  border: 1px solid $border;
  padding: 4px;
}

calendar:selected {
  background-color: $accent_strong;
  color: $washi_50;
}

calendar.header {
  background-color: $surface_raised;
  color: $text_muted;
}

calendar.button {
  background-color: transparent;
  border: 0;
  color: $text;
}

calendar.highlight {
  color: $accent;
  font-weight: 600;
}

expander arrow {
  color: $text_muted;
}

colorswatch {
  border: 1px solid $border_strong;
  border-radius: $radius_sm;
}

colorswatch:selected {
  border-color: $focus;
  box-shadow: 0 0 0 1px $focus;
}

placessidebar,
placessidebar list {
  background-color: $bg_alt;
  color: $text;
}

placessidebar row {
  min-height: 30px;
  padding: 3px 8px;
  border-radius: $radius_sm;
}

placessidebar row:selected {
  background-color: $surface_raised;
  color: $text;
  box-shadow: inset 2px 0 0 $accent_strong;
}

placessidebar row:hover {
  background-color: $surface;
}

filechooser .dialog-action-box {
  border-top: 1px solid $border;
  padding: 8px;
}

.sidebar,
.navigation-sidebar {
  background-color: $bg_alt;
  color: $text;
  border-right: 1px solid $border;
}

.sidebar row:selected,
.navigation-sidebar row:selected {
  background-color: $surface_raised;
  color: $text;
  box-shadow: inset 2px 0 0 $accent_strong;
}

assistant .sidebar {
  background-color: $bg_alt;
  border-right: 1px solid $border;
}

dialog .dialog-action-area {
  padding: 8px;
  border-top: 1px solid $border;
}

messagedialog .titlebar {
  min-height: 30px;
}

messagedialog .dialog-action-area button {
  min-width: 96px;
}

.app-notification,
.app-notification.frame,
.notification {
  background-color: $surface_raised;
  color: $text;
  border: 1px solid $border;
  border-left: 3px solid $accent;
  border-radius: 0;
  padding: 10px 12px;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
}

.app-notification button {
  min-height: 26px;
  padding: 3px 8px;
}

.osd,
.osd.background {
  background-color: alpha($bg_alt, 0.94);
  color: $text;
  border: 1px solid $border;
  border-radius: $radius_sm;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
}

.nemo-window .sidebar,
.nemo-window .nemo-places-sidebar {
  background-color: $bg_alt;
  color: $text;
  border-right: 1px solid $border;
}

.nemo-window .nemo-places-sidebar .view:selected {
  background-color: $surface_raised;
  color: $text;
  box-shadow: inset 2px 0 0 $accent_strong;
}

.nemo-window .nemo-window-pane {
  background-color: $bg;
}

.nemo-window .nemo-inactive-pane .view {
  background-color: $bg_alt;
  color: $text_muted;
}

.nemo-window toolbar {
  background-color: $surface;
}

.xfce4-panel,
.xfce4-panel.background {
  background-color: $bg_alt;
  color: $text;
  border-top: 1px solid $border;
}

.xfce4-panel button {
  min-height: 24px;
  padding: 2px 6px;
  border-radius: 0;
}

.xfce4-panel .tasklist button:checked {
  box-shadow: inset 0 -2px 0 $accent_strong;
}

.lxqt-panel,
.lxqt-panel QWidget {
  background-color: $bg_alt;
  color: $text;
}

.nautilus-window .sidebar,
.nautilus-window placessidebar {
  background-color: $bg_alt;
}

.gedit-side-panel-paned,
.gedit-bottom-panel-paned {
  background-color: $bg_alt;
  border-color: $border;
}

.gedit-document-panel {
  background-color: $bg_alt;
}

.gedit-document-panel row:selected {
  background-color: $surface_raised;
  box-shadow: inset 2px 0 0 $accent_strong;
}

terminal-window,
vte-terminal {
  background-color: $bg_alt;
  color: $text;
}

terminal-window headerbar {
  background-color: $surface;
}

.terminal-screen,
.terminal-screen-container {
  background-color: $bg_alt;
}

.gtkstyle-fallback {
  background-color: $bg;
  color: $text;
}

.gtkstyle-fallback:hover {
  background-color: $surface;
}

.gtkstyle-fallback:active {
  background-color: $bg_alt;
}

.gtkstyle-fallback:disabled {
  background-color: $bg;
  color: $ash_500;
}

.gtkstyle-fallback:selected {
  background-color: $accent_strong;
  color: $washi_50;
}

.dnd,
.dnd-target,
.drag-icon {
  background-color: $surface_raised;
  border: 1px solid $focus;
  border-radius: $radius_sm;
}

rubberband,
.rubberband,
.content-view rubberband {
  background-color: alpha($accent_strong, 0.20);
  border: 1px solid $accent;
}

magnifier {
  background-color: $bg_alt;
}

/* Reduced motion is applied by the arashios-accessibility helper, which sets
 * gtk-enable-animations=0. This file keeps transitions short and predictable.
 */
