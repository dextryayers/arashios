# ArashiOS Kage Openbox theme.
# Generated by scripts/generate-theme.py from branding/tokens.json.
# Source template: branding/theme/templates/openbox-3/themerc.in

border.width: 2
padding.width: 4
padding.height: 4
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0

window.active.border.color: $accent_strong
window.inactive.border.color: $border
window.active.title.bg: Flat Solid
window.active.title.bg.color: $surface
window.inactive.title.bg: Flat Solid
window.inactive.title.bg.color: $bg
window.active.label.text.color: $text
window.inactive.label.text.color: $text_muted
window.label.text.justify: Left
window.label.text.shadow.x: 0
window.label.text.shadow.y: 0
window.label.text.shadow.alpha: 0
window.active.button.unpressed.image.color: $text
window.inactive.button.unpressed.image.color: $text_muted
window.active.button.hover.bg: Flat Solid
window.active.button.hover.bg.color: $surface_raised
window.active.button.pressed.bg: Flat Solid
window.active.button.pressed.bg.color: $accent_strong
window.active.button.pressed.image.color: $washi_50
window.inactive.button.hover.bg: Flat Solid
window.inactive.button.hover.bg.color: $surface
window.inactive.button.pressed.bg: Flat Solid
window.inactive.button.pressed.bg.color: $border_strong
window.active.button.disabled.image.color: $ash_500
window.active.button.toggled.bg: Flat Solid
window.active.button.toggled.bg.color: $surface_raised
window.active.button.toggled.image.color: $accent
window.active.grip.bg: Flat Solid
window.active.grip.bg.color: $surface
window.inactive.grip.bg: Flat Solid
window.inactive.grip.bg.color: $bg

menu.items.bg: Flat Solid
menu.items.bg.color: $surface_raised
menu.items.text.color: $text
menu.items.disabled.text.color: $ash_500
menu.items.active.bg: Flat Solid
menu.items.active.bg.color: $accent_strong
menu.items.active.text.color: $washi_50
menu.separator.color: $border
menu.separator.width: 1
menu.separator.padding.width: 8
menu.separator.padding.height: 4
menu.title.bg: Flat Solid
menu.title.bg.color: $surface
menu.title.text.color: $text_muted
menu.title.text.justify: Left
menu.border.color: $border
menu.border.width: 1
menu.overlap.x: 0
menu.overlap.y: 0

osd.bg: Flat Solid
osd.bg.color: $bg_alt
osd.border.color: $border
osd.border.width: 1
osd.label.text.color: $text
osd.hilight.bg: Flat Solid
osd.hilight.bg.color: $accent_strong
osd.unhilite.bg: Flat Solid
osd.unhilite.bg.color: $surface_raised

window.active.button.unpressed.bg: Flat Solid
window.active.button.unpressed.bg.color: $surface
window.inactive.button.unpressed.bg: Flat Solid
window.inactive.button.unpressed.bg.color: $bg

snapping.overlay.region.bg.color: $accent_alpha
snapping.overlay.edge.bg.color: $accent_alpha
