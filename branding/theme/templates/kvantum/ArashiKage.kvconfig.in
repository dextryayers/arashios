[%General]
author=ArashiOS Project
comment=Kage flat dark theme for Qt 5 applications. Generated from branding/tokens.json.
x11drag=all
alt_mnemonic=true
left_tabs=false
attach_active_tab=true
group_toolbar_buttons=true
spread_progressbar=true
progressbar_thickness=2
composite=true
menu_shadow_depth=8
spread_menuitems=true
tooltip_shadow_depth=4
splitter_width=2
scroll_width=8
scroll_min_extent=40
scroll_arrows=false
combo_as_lineedit=true
inline_spin_indicators=true
slider_width=4
slider_handle_width=14
slider_handle_length=14
check_size=16
toolbar_icon_size=16
dark_titlebar=true
animate_states=true
transient_scrollbar=true

[GeneralColors]
window.color=$surface
base.color=$bg_alt
alt.base.color=$surface
button.color=$surface_raised
light.color=$border_strong
mid.light.color=$border
dark.color=$bg_alt
mid.color=$surface
highlight.color=$accent_strong
inactive.highlight.color=$accent_pressed
text.color=$text
window.text.color=$text
button.text.color=$text
disabled.text.color=$text_muted
tooltip.text.color=$text
highlight.text.color=$washi_50
link.color=$accent
link.visited.color=$accent_pressed

[Hacks]
respect_darkness=true
transparent_ktitle_label=true

[PanelButtonCommand]
frame=true
frame.element=button
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
interior=true
interior.element=button
indicator.size=9
indicator.element=arrow-down
text.normal.color=$text
text.focus.color=$text
text.press.color=$washi_50
text.toggle.color=$washi_50
text.shadow=0
text.margin=1
text.iconspacing=4
text.margin.top=4
text.margin.bottom=4
text.margin.left=4
text.margin.right=4

[PanelButtonTool]
inherits=PanelButtonCommand
interior.element=tbutton
frame.element=tbutton

[Dock]
inherits=PanelButtonCommand
frame=true
interior=true

[DockTitle]
inherits=PanelButtonCommand
frame=false
interior=false
text.focus.color=$text
text.bold=true

[IndicatorSpinBox]
inherits=PanelButtonCommand
indicator.element=arrow
indicator.size=9

[RadioButton]
inherits=PanelButtonCommand
frame=false
interior.element=radio

[CheckBox]
inherits=PanelButtonCommand
frame=false
interior.element=checkbox

[GenericFrame]
inherits=PanelButtonCommand
frame=true
interior=false
frame.element=common
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[LineEdit]
inherits=PanelButtonCommand
frame.element=lineedit
interior.element=lineedit
text.margin.left=4
text.margin.right=4
text.margin.top=4
text.margin.bottom=4

[DropDownButton]
inherits=PanelButtonCommand
indicator.element=arrow-down

[IndicatorArrow]
indicator.element=arrow
indicator.size=9

[ToolboxTab]
inherits=PanelButtonCommand

[Tab]
inherits=PanelButtonCommand
interior.element=tab
frame.element=tab
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
indicator.element=tab
text.margin.left=8
text.margin.right=8
text.margin.top=4
text.margin.bottom=4
min_height=2.0font

[TabFrame]
inherits=PanelButtonCommand
frame.element=tabframe
interior=false
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[TreeExpander]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.size=9

[HeaderSection]
inherits=PanelButtonCommand
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
text.margin.top=3
text.margin.bottom=3

[SizeGrip]
inherits=PanelButtonCommand
frame=false
interior=false
indicator.element=resize-grip
indicator.size=12

[Toolbar]
inherits=PanelButtonCommand
indicator.element=toolbar
indicator.size=4
text.margin=0
frame.element=toolbar
interior=false

[Slider]
inherits=PanelButtonCommand
frame.element=slider
interior.element=slider
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[SliderCursor]
inherits=PanelButtonCommand
frame=false
interior.element=slidercursor

[Progressbar]
inherits=PanelButtonCommand
frame.element=progress
interior.element=progress
text.margin=0
text.focus.color=$text
text.press.color=$text
text.toggle.color=$text
text.bold=true

[ProgressbarContents]
inherits=PanelButtonCommand
frame=true
frame.element=progress-pattern
interior.element=progress-pattern
frame.top=0
frame.bottom=0
frame.left=0
frame.right=0

[ItemView]
inherits=PanelButtonCommand
text.margin=1
text.margin.top=2
text.margin.bottom=2
text.margin.left=4
text.margin.right=4
frame.element=itemview
interior.element=itemview
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[Splitter]
inherits=PanelButtonCommand
interior.element=splitter
frame.element=splitter
frame.top=0
frame.bottom=0
frame.left=1
frame.right=1
indicator.element=splitter-grip
indicator.size=12

[Scrollbar]
inherits=PanelButtonCommand
indicator.size=9

[ScrollbarSlider]
inherits=PanelButtonCommand
frame.element=scrollbarslider
interior.element=scrollbarslider
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
indicator.element=grip
indicator.size=12

[ScrollbarTransientSlider]
frame=true
frame.element=ss
interior=false
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[ScrollbarGroove]
inherits=PanelButtonCommand
interior.element=scrollbargroove
frame.element=scrollbargroove
frame.top=0
frame.bottom=0
frame.left=2
frame.right=2

[MenuItem]
inherits=PanelButtonCommand
frame=true
frame.element=menuitem
interior.element=menuitem
indicator.element=menuitem
text.focus.color=$washi_50
text.margin.top=2
text.margin.bottom=2
text.margin.left=6
text.margin.right=6
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1

[MenuBarItem]
inherits=PanelButtonCommand
interior.element=menubaritem
frame.element=menubaritem
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2
text.margin.left=6
text.margin.right=6

[TitleBar]
inherits=PanelButtonCommand
frame=false
interior.element=titlebar
indicator.size=12
indicator.element=mdi
text.normal.color=$text
text.focus.color=$text
text.bold=false
text.italic=false

[ComboBox]
inherits=PanelButtonCommand

[Menu]
inherits=PanelButtonCommand
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
frame.element=menu
interior.element=menu

[GroupBox]
inherits=GenericFrame
frame=true
frame.element=group
text.shadow=0
text.margin=0
frame.top=2
frame.bottom=2
frame.left=2
frame.right=2

[TabBarFrame]
inherits=GenericFrame
frame=false
interior=false
text.shadow=0

[ToolTip]
inherits=GenericFrame
frame.top=1
frame.bottom=1
frame.left=1
frame.right=1
interior=true
text.shadow=0
text.margin=0
interior.element=tooltip
frame.element=tooltip

[StatusBar]
inherits=GenericFrame
frame=false
interior=false

[Window]
interior=false
