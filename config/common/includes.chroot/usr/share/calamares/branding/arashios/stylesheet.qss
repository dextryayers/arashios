/* ArashiOS installer stylesheet.
   Colors follow the Kage design tokens used by the desktop theme. */

#sidebarApp {
    background-color: #0A0A0C;
    color: #EDE8DE;
}

#sidebarApp QLabel {
    color: #EDE8DE;
}

#sidebarApp QPushButton {
    background-color: transparent;
    border: none;
    color: #EDE8DE;
    padding: 6px;
}

#sidebarApp QPushButton:checked {
    background-color: #BF4432;
    color: #0A0A0C;
}

#sidebarApp QProgressBar {
    background-color: #121216;
    border: 1px solid #25252D;
    border-radius: 2px;
    text-align: center;
    color: #EDE8DE;
}

#sidebarApp QProgressBar::chunk {
    background-color: #DD785B;
}

#navigationApp {
    background-color: #121216;
}

#navigationApp QPushButton {
    background-color: #1B1B21;
    border: 1px solid #25252D;
    border-radius: 2px;
    color: #EDE8DE;
    padding: 6px 14px;
}

#navigationApp QPushButton:hover {
    border-color: #DD785B;
}
