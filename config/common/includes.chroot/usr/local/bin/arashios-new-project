#!/usr/bin/env python3
"""Create ArashiOS project templates.

The command renders a template into a new directory, replaces the placeholders,
and never overwrites existing files unless it is asked to.
"""

from __future__ import annotations

import argparse
import datetime
import json
import os
import re
import shutil
import sys
from pathlib import Path

TEMPLATE_CANDIDATES = [
    Path(os.environ.get("ARASHIOS_TEMPLATES", "/usr/share/arashios/templates/projects")),
    Path(__file__).resolve().parents[2] / "share" / "arashios" / "templates" / "projects",
]
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9._-]*$")


def template_root() -> Path:
    for candidate in TEMPLATE_CANDIDATES:
        if candidate.is_dir():
            return candidate
    raise SystemExit("ERROR: template proyek tidak ditemukan.")


def kinds() -> list[str]:
    root = template_root()
    return sorted(
        path.name
        for path in root.iterdir()
        if path.is_dir() and path.name != "common"
    )


def slugify(value: str) -> str:
    slug = re.sub(r"[^a-z0-9._-]+", "-", value.strip().lower()).strip("-")
    return slug or "proyek"


def render(text: str, mapping: dict[str, str]) -> str:
    for key, value in mapping.items():
        text = text.replace(key, value)
    return text


def copy_template(kind: str, target: Path, mapping: dict[str, str], dry_run: bool) -> list[str]:
    root = template_root()
    written: list[str] = []
    sources = [root / "common"]
    kind_dir = root / kind
    if kind_dir.is_dir():
        sources.append(kind_dir)
    for source in sources:
        if not source.is_dir():
            continue
        for path in sorted(source.rglob("*")):
            if path.is_dir():
                continue
            relative = path.relative_to(source)
            relative = Path(render(str(relative), mapping))
            destination = target / relative
            if path.suffix == ".sh" or path.name.endswith(".sh"):
                destination.parent.mkdir(parents=True, exist_ok=True)
                if not dry_run:
                    destination.write_text(render(path.read_text(encoding="utf-8"), mapping), encoding="utf-8")
                    destination.chmod(0o755)
                written.append(str(destination))
                continue
            destination.parent.mkdir(parents=True, exist_ok=True)
            if not dry_run:
                destination.write_text(render(path.read_text(encoding="utf-8"), mapping), encoding="utf-8")
            written.append(str(destination))
    return written


def command_list(args: argparse.Namespace) -> int:
    names = kinds()
    if args.json:
        print(json.dumps({"templates": names}, indent=2))
        return 0
    for name in names:
        print(name)
    print(f"\n{len(names)} template proyek.")
    return 0


def command_create(args: argparse.Namespace) -> int:
    kind = args.kind
    if kind not in kinds():
        print(f"ERROR: template tidak dikenal: {kind}", file=sys.stderr)
        print("Jalankan arashios-new-project list untuk daftar template.", file=sys.stderr)
        return 2
    target = Path(args.directory).resolve()
    name = slugify(args.name or target.name)
    if not NAME_RE.match(name):
        print(f"ERROR: nama proyek tidak valid: {name}", file=sys.stderr)
        return 2
    if target.exists() and any(target.iterdir()) and not args.force:
        print(
            f"ERROR: {target} sudah berisi berkas. Gunakan --force untuk menimpa.",
            file=sys.stderr,
        )
        return 2
    today = datetime.date.today().isoformat()
    mapping = {
        "@NAME@": name,
        "@UPPER@": name.upper().replace("-", "_").replace(".", "_"),
        "@MODULE@": args.module or name,
        "@DATE@": today,
        "@YEAR@": today[:4],
    }
    written = copy_template(kind, target, mapping, args.dry_run)
    if args.dry_run:
        print(f"DRY RUN: {len(written)} berkas akan dibuat di {target}")
        for path in written:
            print(f"  {path}")
        return 0
    print(f"Proyek {name} dibuat di {target}")
    print(f"  {len(written)} berkas")
    print("Langkah berikutnya:")
    print(f"  cd {target}")
    print("  make help")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Template proyek ArashiOS")
    parser.add_argument("--json", action="store_true")
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument("--json", action="store_true", default=argparse.SUPPRESS, help="keluaran JSON")
    sub = parser.add_subparsers(dest="command", required=True)

    listing = sub.add_parser("list", parents=[shared], help="daftar template")
    listing.set_defaults(func=command_list)

    create = sub.add_parser("create", parents=[shared], help="buat proyek dari template")
    create.add_argument("kind")
    create.add_argument("directory")
    create.add_argument("--name", help="nama proyek")
    create.add_argument("--module", help="nama modul untuk bahasa Go")
    create.add_argument("--force", action="store_true")
    create.add_argument("--dry-run", action="store_true")
    create.set_defaults(func=command_create)

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
