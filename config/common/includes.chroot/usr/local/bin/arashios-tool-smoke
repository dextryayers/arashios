#!/usr/bin/env python3
"""ArashiOS toolstack smoke harness.

Runs the smoke test of every tool in the catalog without network access and
writes a JSON report that can be archived with a release.
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(
    0,
    str(Path(__file__).resolve().parent.parent / "lib" / "arashios"),
)

from toolstack import load_catalog, run_tool_test, tool_workflows, tools_of  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description="Smoke test toolstack ArashiOS")
    parser.add_argument("--catalog", help="lintak katalog toolstack")
    parser.add_argument("--tier", help="filter tier, contoh T0")
    parser.add_argument("--workflow", help="filter alur kerja, contoh WF-02")
    parser.add_argument("--tool", help="uji satu tool")
    parser.add_argument("--output", help="tulis laporan JSON ke berkas")
    parser.add_argument("--json", action="store_true", help="cetak laporan JSON ke stdout")
    parser.add_argument("--timeout", type=int, default=30, help="batas waktu tiap perintah")
    args = parser.parse_args()

    catalog = load_catalog(args.catalog)
    tools = tools_of(catalog)
    if args.tier:
        tools = [tool for tool in tools if tool["tier"] == args.tier.upper()]
    if args.workflow:
        wanted = args.workflow.upper()
        tools = [tool for tool in tools if wanted in tool_workflows(tool)]
    if args.tool:
        tools = [tool for tool in tools if tool["name"] == args.tool]

    results = [run_tool_test(tool, timeout=args.timeout) for tool in tools]
    failures = [item for item in results if item["status"] in {"failed", "missing", "timeout"}]
    report = {
        "catalog_version": catalog.get("catalog_version", ""),
        "checked": len(results),
        "failures": len(failures),
        "results": results,
    }

    if args.output:
        path = Path(args.output)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")

    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        for item in results:
            print(f"{item['status']:<9} {item['tier']:<3} {item['name']:<22} {item['detail'][:60]}")
        print(f"\n{len(results)} diuji, {len(failures)} gagal.")
    return 1 if failures else 0


if __name__ == "__main__":
    raise SystemExit(main())
