# ArashiOS Kage GTK2 system defaults. Kept minimal because the theme package
# supplies the widget drawing; this file only selects it for legacy apps.
gtk-theme-name = "ArashiKage"
gtk-icon-theme-name = "Papirus-Dark"
gtk-font-name = "Inter 10"
gtk-cursor-theme-name = "Bibata-Modern-Classic"
gtk-cursor-theme-size = 24
gtk-enable-animations = 1
gtk-menu-images = 1
gtk-button-images = 0
gtk-toolbar-style = 0
gtk-toolbar-icon-size = 1
