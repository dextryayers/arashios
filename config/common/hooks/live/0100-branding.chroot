#!/bin/sh
# ArashiOS branding hook. Runs inside the build chroot.
set -eu
export DEBIAN_FRONTEND=noninteractive

if [ -f /etc/default/grub ]; then
    grep -q '^GRUB_THEME=' /etc/default/grub || \
        printf '%s\n' 'GRUB_THEME="/usr/share/grub/themes/arashios/theme.txt"' >> /etc/default/grub
    grep -q '^GRUB_TIMEOUT_STYLE=' /etc/default/grub || \
        printf '%s\n' 'GRUB_TIMEOUT_STYLE=menu' >> /etc/default/grub
    grep -q '^GRUB_TIMEOUT=' /etc/default/grub || \
        printf '%s\n' 'GRUB_TIMEOUT=5' >> /etc/default/grub
    grep -q '^GRUB_DISABLE_OS_PROBER=' /etc/default/grub || \
        printf '%s\n' 'GRUB_DISABLE_OS_PROBER=false' >> /etc/default/grub
fi

mkdir -p /etc/plymouth
cat > /etc/plymouth/plymouthd.conf <<'EOF'
[Daemon]
Theme=arashios
ShowDelay=0
EOF

if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme arashios >/dev/null 2>&1 || true
fi

if command -v nvim >/dev/null 2>&1; then
    update-alternatives --install /usr/bin/editor editor /usr/bin/nvim 60 >/dev/null 2>&1 || true
fi

if command -v fc-cache >/dev/null 2>&1; then
    fc-cache -f >/dev/null 2>&1 || true
fi

# Cinnamon reads applet defaults from the installed JSON schema. ArashiOS
# uses a date and time clock rather than the upstream locale-default label.
CALENDAR_SCHEMA=/usr/share/cinnamon/applets/calendar@cinnamon.org/settings-schema.json
if [ -f "$CALENDAR_SCHEMA" ] && command -v python3 >/dev/null 2>&1; then
    python3 - "$CALENDAR_SCHEMA" <<'PY_CALENDAR'
import json
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as handle:
    schema = json.load(handle)
schema.setdefault("use-custom-format", {})["default"] = True
schema.setdefault("custom-format", {})["default"] = "%Y.%m.%d %H:%M"
schema.setdefault("custom-tooltip-format", {})["default"] = "%A, %d %B %Y %H:%M"
with open(path, "w", encoding="utf-8") as handle:
    json.dump(schema, handle, indent=4, ensure_ascii=False)
    handle.write("\n")
PY_CALENDAR
fi

if [ -f /usr/share/cinnamon/applets/menu@cinnamon.org/settings-schema.json ] && command -v python3 >/dev/null 2>&1; then
    python3 - /usr/share/cinnamon/applets/menu@cinnamon.org/settings-schema.json <<'PY_MENU'
import json
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as handle:
    schema = json.load(handle)
schema.setdefault("menu-custom", {})["default"] = True
schema.setdefault("menu-icon", {})["default"] = "arashios"
schema.setdefault("menu-icon-size", {})["default"] = 18
schema.setdefault("menu-label", {})["default"] = "Arashi"
with open(path, "w", encoding="utf-8") as handle:
    json.dump(schema, handle, indent=4, ensure_ascii=False)
    handle.write("\n")
PY_MENU
fi

if [ -f /usr/share/cinnamon/applets/workspace-switcher@cinnamon.org/settings-schema.json ] && command -v python3 >/dev/null 2>&1; then
    python3 - /usr/share/cinnamon/applets/workspace-switcher@cinnamon.org/settings-schema.json <<'PY_WORKSPACE'
import json
import sys

path = sys.argv[1]
with open(path, encoding="utf-8") as handle:
    schema = json.load(handle)
schema.setdefault("display-type", {})["default"] = "buttons"
with open(path, "w", encoding="utf-8") as handle:
    json.dump(schema, handle, indent=4, ensure_ascii=False)
    handle.write("\n")
PY_WORKSPACE
fi

if command -v dconf >/dev/null 2>&1 && [ -d /etc/dconf/db/local.d ]; then
    dconf update >/dev/null 2>&1 || true
fi

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
fi

chmod 0755 /usr/local/bin/arashios-wallpaper 2>/dev/null || true
chmod 0755 /usr/local/bin/arashios-accessibility /usr/local/bin/kage-contrast 2>/dev/null || true
chmod 0644 /etc/xdg/autostart/arashios-wallpaper.desktop 2>/dev/null || true
chmod 0644 /etc/skel/.zshrc /etc/skel/.tmux.conf /etc/skel/.gitconfig /etc/skel/.ripgreprc 2>/dev/null || true
find /etc/skel -type d -exec chmod 0755 {} + 2>/dev/null || true
find /etc/skel -type f -exec chmod 0644 {} + 2>/dev/null || true

# Keep the live user's skeleton readable by the live session.
if [ -d /etc/skel ]; then
    chown -R root:root /etc/skel
fi

sync
